<Window x:Class="Nexora.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Nexora.App.Views"
        xmlns:vm="clr-namespace:Nexora.App.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Nexora"
        Height="780" Width="1280"
        MinHeight="640" MinWidth="1024"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        x:Name="RootWindow"
        Icon="{StaticResource NexoraAppIcon}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="8"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" /> <!-- Left Sidebar Navigation -->
            <ColumnDefinition Width="*" />   <!-- Main Content Area -->
        </Grid.ColumnDefinitions>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        Width="0" Height="0"
                        Visibility="Collapsed"
                        ToolTipText="Nexora"
                        PreviewTrayContextMenuOpen="TrayIcon_PreviewTrayContextMenuOpen"
                        IconSource="/Nexora;component/Assets/NEXORA_icon_light.ico">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <!-- Recently used games are inserted above this separator when the menu opens. -->
                    <Separator x:Name="TrayGamesSeparator" Visibility="Collapsed" />
                    <MenuItem Header="{DynamicResource TrayOpen}" Click="TrayOpen_Click" />
                    <MenuItem Header="{DynamicResource TrayExit}" Click="TrayExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Left Sidebar Navigation -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,24,16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Brand Logo -->
                    <RowDefinition Height="Auto" /> <!-- Local profile -->
                    <RowDefinition Height="*" />    <!-- Navigation Items -->
                    <RowDefinition Height="Auto" /> <!-- Time greeting -->
                </Grid.RowDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0,0,20"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown">
                    <Border Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True">
                        <Image Source="{StaticResource NexoraAppIcon}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Nexora"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource AppBrandSubtitle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Local profile block keeps the game library on this device. -->
                <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0" CornerRadius="10" Padding="12,8" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#343434" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProfileInitials}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource AppProfileUser}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource AppProfileLocal}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Row="2">
                    <!-- Home -->
                    <Button Command="{Binding NavigateHomeCommand}"
                            Margin="0,0,0,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeActive}" Value="True">
                                        <Setter Property="Background" Value="#303030" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,12,0">
                                <Path Data="M3,9 L10,3 L17,9 V17 H12 V12 H8 V17 H3 Z" Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                            <TextBlock Text="{DynamicResource NavHome}" />
                        </StackPanel>
                    </Button>

                    <!-- Downloads -->
                    <Button Command="{Binding NavigateDownloadsCommand}"
                            Margin="0,6,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDownloadsActive}" Value="True">
                                        <Setter Property="Background" Value="#303030" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,12,0">
                                <Path Data="M10,2 V12 M6,8 L10,12 L14,8 M3,14 V18 H17 V14" Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                            <TextBlock Text="{DynamicResource NavDownloads}" />
                            <views:CircularProgressRing Width="14" Height="14" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        IsHitTestVisible="False"
                                                        Progress="{Binding TorrentDownloadProgressPercent}"
                                                        Visibility="{Binding HasActiveTorrentDownload, Converter={StaticResource BoolToVis}}" />
                            <Border Width="14" Height="14" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource SuccessBrush}"
                                    CornerRadius="7"
                                    IsHitTestVisible="False"
                                    ToolTip="{DynamicResource SidebarCompletedDownloadsHint}"
                                    Visibility="Hidden"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0.82" ScaleY="0.82" />
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCompletedDownloads}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0" To="1" Duration="0:0:0.22" />
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                             From="0.82" To="1" Duration="0:0:0.22" />
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                             From="0.82" To="1" Duration="0:0:0.22" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="✓" FontSize="9" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-1,0,0" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Settings -->
                    <Button Command="{Binding NavigateSettingsCommand}" Margin="0,6,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                                        <Setter Property="Background" Value="#303030" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,12,0">
                                <Path Data="M10,2 L12,2 L13,4 L15,5 L17,4 L18,6 L17,8 L18,10 L20,11 L20,13 L18,14 L17,16 L18,18 L16,20 L14,19 L12,20 L11,22 L9,22 L8,20 L6,19 L4,20 L2,18 L3,16 L2,14 L0,13 L0,11 L2,10 L3,8 L2,6 L4,4 L6,5 L8,4 Z M10,8 A3,3 0 1 0 10,14 A3,3 0 1 0 10,8" Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                            <TextBlock Text="{DynamicResource NavSettings}" />
                        </StackPanel>
                    </Button>

                    <!-- Divider before the personal library section -->
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="6,14,6,14" Opacity="0.8" />

                    <TextBlock Text="{DynamicResource MyLibrary}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,8" />

                    <!-- Library -->
                    <Button Command="{Binding NavigateLibraryCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLibraryActive}" Value="True">
                                        <Setter Property="Background" Value="#303030" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,12,0">
                                <Path Data="M1.5,16.5 H16.5 M3.5,4 H6.5 V16.5 H3.5 Z M7.5,6 H10.5 V16.5 H7.5 Z M12,4.8 L14.7,5.9 L16.8,16.5 H13.8 Z M4.5,6.5 H5.5 M8.5,8.5 H9.5" Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                            <TextBlock Text="{DynamicResource NavLibrary}" />
                        </StackPanel>
                    </Button>

                    <!-- Sidebar Library Panel: search + installed games list -->
                    <Border Margin="0,8,0,0"
                            Background="#151515"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="8,8,8,4">
                        <StackPanel>
                            <!-- Search box -->
                            <Grid Margin="0,0,0,6">
                                <TextBox x:Name="LibrarySearchBox"
                                         Text="{Binding LibrarySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}"
                                         shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                         Height="34"
                                         Padding="34,0,10,0"
                                         VerticalContentAlignment="Center"
                                         FontSize="12" />
                                <Viewbox Width="14" Height="14" Margin="10,0,0,0" VerticalAlignment="Center"
                                         HorizontalAlignment="Left" IsHitTestVisible="False">
                                    <Path Data="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 M13,13 L19,19" Fill="Transparent"
                                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" />
                                </Viewbox>
                                <!-- Placeholder -->
                                <TextBlock Text="{DynamicResource SidebarLibrarySearchPlaceholder}"
                                           FontSize="12"
                                           Margin="34,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LibrarySearchQuery}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=LibrarySearchBox}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Installed games list -->
                            <ListBox ItemsSource="{Binding LibraryGames}"
                                     MaxHeight="280"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding PlayCommand}"
                                                Style="{StaticResource NavButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Margin="0"
                                                Cursor="Hand"
                                                FocusVisualStyle="{StaticResource NexoraFocusVisualStyle}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Border Margin="0,1"
                                                    Padding="6,5"
                                                    CornerRadius="6"
                                                    Background="Transparent">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#303030" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <Ellipse Grid.Column="1"
                                                             Width="8" Height="8"
                                                             Margin="4,0,0,0"
                                                             VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Empty state -->
                            <TextBlock Text="{DynamicResource SidebarEmptyLibrary}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LibraryGames.IsEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Text="{Binding TimeGreeting}"
                           Margin="8,0,0,2"
                           VerticalAlignment="Bottom"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="15"
                           FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- Main Content Host -->
        <Grid Grid.Column="1">
            <!-- Home / Catalog View -->
            <Grid x:Name="HomePage"
                  Visibility="{Binding IsHomeActive, Converter={StaticResource BoolToVis}}"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <views:HomeView />
            </Grid>

            <!-- Library View -->
            <Grid x:Name="LibraryPage"
                  Visibility="{Binding IsLibraryActive, Converter={StaticResource BoolToVis}}"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <views:LibraryView />
            </Grid>

            <!-- Downloads View -->
            <Grid x:Name="DownloadsPage"
                  Visibility="{Binding IsDownloadsActive, Converter={StaticResource BoolToVis}}"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <views:DownloadsView />
            </Grid>

            <!-- Settings View -->
            <Grid x:Name="SettingsPage"
                  Visibility="{Binding IsSettingsActive, Converter={StaticResource BoolToVis}}"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <views:SettingsView DataContext="{Binding SettingsVM}" />
            </Grid>
        </Grid>
        <!-- Window control buttons — float top-right, work inside caption area -->
        <StackPanel x:Name="WindowControlButtons"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,12,0"
                    Panel.ZIndex="100">

            <!-- Minimize -->
            <Button x:Name="BtnMinimize"
                    Click="BtnMinimize_Click"
                    Width="36" Height="28"
                    Margin="1,0"
                    ToolTip="{DynamicResource WindowMinimize}"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                                            BorderBrush="Transparent" BorderThickness="0" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#282828" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <Path Data="M4,12 H20" Width="12" Height="2" Stretch="Fill"
                      Stroke="#94A3B8" StrokeThickness="1.2"
                      StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
            </Button>

            <!-- Maximize / Restore -->
            <Button x:Name="BtnMaximize"
                    Click="BtnMaximize_Click"
                    Width="36" Height="28"
                    Margin="1,0"
                    ToolTip="{DynamicResource WindowMaximizeRestore}"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                                            BorderBrush="Transparent" BorderThickness="0" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#282828" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <Path x:Name="MaxIcon" Width="10" Height="10" Stretch="Fill"
                      Data="M5,5 H19 V19 H5 Z" Fill="Transparent"
                      Stroke="#94A3B8" StrokeThickness="1.1" />
            </Button>

            <!-- Close -->
            <Button x:Name="BtnClose"
                    Click="BtnClose_Click"
                    Width="36" Height="28"
                    Margin="1,0"
                    ToolTip="{DynamicResource WindowClose}"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#CC3B2F" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <Path Data="M4,4 L20,20 M20,4 L4,20"
                      Width="14" Height="14" Stretch="Fill"
                      Stroke="#94A3B8" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
