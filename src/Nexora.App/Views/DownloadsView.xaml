<UserControl x:Class="Nexora.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             AllowDrop="True"
             Drop="OnTorrentDrop"
             DragOver="OnDragOver">

    <UserControl.Resources>
        <!-- Compact Action Button Style for Downloads Header & Cards -->
        <Style x:Key="DownloadGhostButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource NexoraFocusVisualStyle}" />
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBgHoverBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="#2D2D2D" />
                                <Setter Property="Foreground" Value="{StaticResource PureWhiteBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#181A20" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Tab Button Style -->
        <Style x:Key="DownloadFilterChipStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource NexoraFocusVisualStyle}" />
            <Setter Property="Background" Value="{StaticResource BgDarkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource CardBgHoverBrush}" />
                                <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                <Setter Property="Foreground" Value="#F3F4F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- State-Aware Rounded Progress Bar -->
        <Style x:Key="DownloadCardProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="{StaticResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                ClipToBounds="True">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DownloadVisualState}" Value="Preparing">
                    <Setter Property="Foreground" Value="#6366F1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DownloadVisualState}" Value="Waiting">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DownloadVisualState}" Value="Queued">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DownloadVisualState}" Value="Paused">
                    <Setter Property="Foreground" Value="{StaticResource SlateMutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DownloadVisualState}" Value="Verifying">
                    <Setter Property="Foreground" Value="#EC4899" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DownloadVisualState}" Value="Installing">
                    <Setter Property="Foreground" Value="#8B5CF6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DownloadVisualState}" Value="Finalizing">
                    <Setter Property="Foreground" Value="#14B8A6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DownloadVisualState}" Value="Completed">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DownloadVisualState}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,48,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════
             ROW 0: Page Header, Telemetry Badges & Quick Global Controls
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource DownloadsTitle}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{DynamicResource DownloadsSubtitle}"
                           FontSize="12.5"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Telemetry & Global Actions -->
            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Active Downloads + Live Speed Pill -->
                <Border Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                        CornerRadius="8"
                        Padding="12,7"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveDownloadsCount}" Value="0">
                                            <Setter Property="Fill" Value="{StaticResource SlateDimBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{DynamicResource DownloadsActiveLabel}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,5,0"
                                   FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveDownloadsCount}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasActiveDownloadSpeed, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text=" • " Margin="4,0" Foreground="{StaticResource SlateDimBrush}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalDownloadSpeedText}"
                                       Foreground="{DynamicResource AccentHoverBrush}"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Queued Downloads Pill -->
                <Border Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                        CornerRadius="8"
                        Padding="12,7"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QueuedDownloadsCount}" Value="0">
                                            <Setter Property="Fill" Value="{StaticResource SlateDimBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{DynamicResource DownloadsQueuedLabel}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,5,0"
                                   FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding QueuedDownloadsCount}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Max Concurrent Downloads Selector Button -->
                <Button Command="{Binding CycleMaxConcurrentDownloadsCommand}"
                        Style="{StaticResource DownloadGhostButtonStyle}"
                        ToolTip="{DynamicResource DownloadsParallelTooltip}"
                        Padding="11,7"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource DownloadsParallelLabel}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,5,0"
                                   FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding MaxConcurrentDownloads}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Add .torrent Button -->
                <Button Content="{DynamicResource DownloadAddTorrentButton}"
                        Command="{Binding AddTorrentFileCommand}"
                        ToolTip="{DynamicResource DownloadAddTorrentTooltip}"
                        Style="{StaticResource DownloadGhostButtonStyle}"
                        Padding="12,7"
                        Margin="0,0,8,0" />

                <!-- Resume All Button -->
                <Button Content="{DynamicResource DownloadResumeAll}"
                        Command="{Binding ResumeAllDownloadsCommand}"
                        Visibility="{Binding CanResumeAllDownloads, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource DownloadGhostButtonStyle}"
                        Padding="12,7"
                        Margin="0,0,8,0" />

                <!-- Pause All Button -->
                <Button Content="{DynamicResource DownloadPauseAll}"
                        Command="{Binding PauseAllDownloadsCommand}"
                        Visibility="{Binding CanPauseAllDownloads, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource DownloadGhostButtonStyle}"
                        Padding="12,7"
                        Margin="0,0,8,0" />

                <!-- Clear Completed Button -->
                <Button Content="{DynamicResource DownloadClearCompleted}"
                        Command="{Binding ClearCompletedDownloadsCommand}"
                        Visibility="{Binding HasCompletedDownloads, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource DownloadGhostButtonStyle}"
                        Padding="12,7" />
            </WrapPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             ROW 1: Filter Chips & Search Bar (Shown when tasks exist)
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,14"
              Visibility="{Binding HasDownloadTasks, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- State Filter Chips -->
            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- All -->
                <Button Command="{Binding SetDownloadsFilterCommand}" CommandParameter="All">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DownloadFilterChipStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterAllSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CardBgHoverBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource PureWhiteBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource DownloadFilterAll}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalDownloadTasksCount, StringFormat='({0})'}"
                                   Margin="5,0,0,0" Opacity="0.7" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Active -->
                <Button Command="{Binding SetDownloadsFilterCommand}" CommandParameter="Active">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DownloadFilterChipStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterActiveSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceLowerBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource PureWhiteBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource DownloadFilterActive}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveDownloadsCount, StringFormat='({0})'}"
                                   Margin="5,0,0,0" Opacity="0.7" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Queued -->
                <Button Command="{Binding SetDownloadsFilterCommand}" CommandParameter="Queued">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DownloadFilterChipStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterQueuedSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceLowerBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource PureWhiteBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource DownloadFilterQueued}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding QueuedDownloadsCount, StringFormat='({0})'}"
                                   Margin="5,0,0,0" Opacity="0.7" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Paused -->
                <Button Command="{Binding SetDownloadsFilterCommand}" CommandParameter="Paused">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DownloadFilterChipStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterPausedSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CardBgHoverBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource PureWhiteBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource DownloadFilterPaused}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PausedDownloadsCount, StringFormat='({0})'}"
                                   Margin="5,0,0,0" Opacity="0.7" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Completed -->
                <Button Command="{Binding SetDownloadsFilterCommand}" CommandParameter="Completed">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DownloadFilterChipStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterCompletedSelected}" Value="True">
                                    <Setter Property="Background" Value="#132A24" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource PureWhiteBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource DownloadFilterCompleted}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CompletedDownloadsCount, StringFormat='({0})'}"
                                   Margin="5,0,0,0" Opacity="0.7" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Errors -->
                <Button Command="{Binding SetDownloadsFilterCommand}" CommandParameter="Error"
                        Visibility="{Binding HasErrorDownloads, Converter={StaticResource BoolToVis}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DownloadFilterChipStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterErrorSelected}" Value="True">
                                    <Setter Property="Background" Value="#2D1519" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                    <Setter Property="Foreground" Value="#FCA5A5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource DownloadFilterError}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ErrorDownloadsCount, StringFormat='({0})'}"
                                   Margin="5,0,0,0" Opacity="0.75" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- Search Box -->
            <Grid Grid.Column="1" Width="240" VerticalAlignment="Center">
                <TextBox x:Name="DownloadsSearchBox"
                         Text="{Binding DownloadsSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         shell:WindowChrome.IsHitTestVisibleInChrome="True"
                         Height="34"
                         Padding="32,0,12,0"
                         FontSize="12" />
                <Viewbox Width="13" Height="13" Margin="11,0,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         IsHitTestVisible="False">
                    <Path Data="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 M13,13 L19,19"
                          Fill="Transparent"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1.8" />
                </Viewbox>
                <TextBlock Text="{DynamicResource DownloadsSearchPlaceholder}"
                           FontSize="12"
                           Margin="32,0,10,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DownloadsSearchQuery}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=DownloadsSearchBox}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             ROW 2: Download Cards List & Empty/Drag States
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,6,0">
                <ItemsControl ItemsSource="{Binding DownloadGames}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CardRootBorder"
                                    Background="{StaticResource CardBgBrush}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="14"
                                    Padding="0"
                                    Margin="0,0,0,14"
                                    ClipToBounds="True"
                                    Loaded="OnDownloadCardLoaded"
                                    SizeChanged="OnDownloadCardSizeChanged">
                                <Grid MinHeight="192">
                                    <!-- Background Cover/Banner Image -->
                                    <Image Source="{Binding FeaturedImageUrl, Converter={StaticResource StringToImage}}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Top"
                                           Height="112"
                                           Opacity="1"
                                           IsHitTestVisible="False" />

                                    <!-- Fade the banner into the card surface at its lower edge. -->
                                    <Border Height="148"
                                            VerticalAlignment="Top"
                                            IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#66111111" Offset="0" />
                                                <GradientStop Color="#66111111" Offset="0.35" />
                                                <GradientStop Color="{StaticResource CardBgColor}" Offset="0.76" />
                                                <GradientStop Color="{StaticResource CardBgColor}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Card Body -->
                                    <Grid Margin="20,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- ── ROW 0: Cover Thumbnail + Game Title + Status Badge ── -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Poster Thumbnail -->
                                            <Viewbox Grid.Column="0"
                                                     MaxWidth="108" MaxHeight="72"
                                                     Stretch="Uniform"
                                                     StretchDirection="DownOnly"
                                                     Margin="0,0,14,0"
                                                     VerticalAlignment="Center">
                                                <Grid>
                                                    <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.35">
                                                        <Path Data="M6,9 H18 A4,4 0 0 1 22,13 V16 A3,3 0 0 1 19,19 H17 L15,16 H9 L7,19 H5 A3,3 0 0 1 2,16 V13 A4,4 0 0 1 6,9 Z"
                                                              Fill="Transparent" Stroke="{StaticResource SlateTextBrush}" StrokeThickness="1.6" />
                                                    </Viewbox>
                                                    <Image Source="{Binding CoverUrl, Converter={StaticResource StringToImage}, ConverterParameter=Card}"
                                                           Stretch="Uniform" />
                                                </Grid>
                                            </Viewbox>

                                            <!-- Title, Package Badge & Stage Subtitle -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PureWhiteBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" />

                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Border Background="{StaticResource SurfaceLowerBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="0"
                                                            CornerRadius="5"
                                                            Padding="7,2"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding VersionTypeDisplay}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#CBD5E1" />
                                                    </Border>
                                                    <TextBlock Text="{Binding DownloadStageSubtitle}"
                                                               FontSize="12"
                                                               Foreground="#B8C0CC"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DownloadStageSubtitle}" />
                                                </StackPanel>

                                                <!-- Network / Stall Warning -->
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,4,0,0"
                                                            Visibility="{Binding IsDownloadStalled, Converter={StaticResource BoolToVis}}">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{DynamicResource DownloadStallWarning}"
                                                               FontSize="11"
                                                               Foreground="#FBBF24"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Status Pill Badge -->
                                            <Border Grid.Column="2"
                                                    VerticalAlignment="Top"
                                                    Background="#CC181B22"
                                                    BorderThickness="0"
                                                    CornerRadius="8"
                                                    Padding="10,5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DownloadVisualState}" Value="Preparing">
                                                                <Setter Property="BorderBrush" Value="#6366F1" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DownloadVisualState}" Value="Waiting">
                                                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DownloadVisualState}" Value="Queued">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DownloadVisualState}" Value="Paused">
                                                                <Setter Property="BorderBrush" Value="{StaticResource SlateMutedBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DownloadVisualState}" Value="Verifying">
                                                                <Setter Property="BorderBrush" Value="#EC4899" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DownloadVisualState}" Value="Installing">
                                                                <Setter Property="BorderBrush" Value="#8B5CF6" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DownloadVisualState}" Value="Finalizing">
                                                                <Setter Property="BorderBrush" Value="#14B8A6" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DownloadVisualState}" Value="Completed">
                                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DownloadVisualState}" Value="Error">
                                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DownloadVisualState}" Value="Preparing">
                                                                        <Setter Property="Fill" Value="#6366F1" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DownloadVisualState}" Value="Waiting">
                                                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DownloadVisualState}" Value="Queued">
                                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DownloadVisualState}" Value="Paused">
                                                                        <Setter Property="Fill" Value="{StaticResource SlateTextBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DownloadVisualState}" Value="Verifying">
                                                                        <Setter Property="Fill" Value="#EC4899" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DownloadVisualState}" Value="Installing">
                                                                        <Setter Property="Fill" Value="#8B5CF6" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DownloadVisualState}" Value="Finalizing">
                                                                        <Setter Property="Fill" Value="#14B8A6" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DownloadVisualState}" Value="Completed">
                                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DownloadVisualState}" Value="Error">
                                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding DownloadStatusText}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- ── ROW 1: Progress Bar & Completion Percentage ── -->
                                        <Grid Grid.Row="1" Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0"
                                                         Style="{StaticResource DownloadCardProgressBar}"
                                                         Value="{Binding ProgressPercent, Mode=OneWay}"
                                                         Maximum="100"
                                                         VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}"
                                                       Width="52"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Grid>

                                        <!-- ── ROW 2: Inline Error Alert Banner (Only when error exists) ── -->
                                        <Border Grid.Row="2"
                                                Margin="0,10,0,0"
                                                Background="#2A1216"
                                                BorderBrush="#7F1D1D"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,8"
                                                Visibility="{Binding HasDownloadError, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{StaticResource DangerBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,9,0" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DownloadErrorText}"
                                                           Foreground="#FCA5A5"
                                                           FontSize="11.5"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- ── ROW 3: Telemetry Metrics Grid ── -->
                                        <Border Grid.Row="3"
                                                Margin="0,12,0,0"
                                                Background="#99101216"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0"
                                                CornerRadius="9"
                                                Padding="14,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.35*" />
                                                    <ColumnDefinition Width="1.05*" />
                                                    <ColumnDefinition Width="1.05*" />
                                                    <ColumnDefinition Width="1.05*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource DownloadReceived}"
                                                               FontSize="9.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding ProgressText}"
                                                               Margin="0,3,0,0"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{DynamicResource DownloadSpeed}"
                                                               FontSize="9.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding DownloadSpeedDisplay}"
                                                               Margin="0,3,0,0"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource DownloadUpload}"
                                                               FontSize="9.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding UploadSpeedText}"
                                                               Margin="0,3,0,0"
                                                               FontSize="12" FontWeight="Medium"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="{DynamicResource DownloadRemaining}"
                                                               FontSize="9.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding RemainingTimeDisplay}"
                                                               Margin="0,3,0,0"
                                                               FontSize="12" FontWeight="Medium"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="{DynamicResource DownloadPeers}"
                                                               FontSize="9.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding PeersDisplay}"
                                                               Margin="0,3,0,0"
                                                               FontSize="12" FontWeight="Medium"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- ── ROW 4: Folder Path + Task & Queue Action Controls ── -->
                                        <Grid Grid.Row="4" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Clickable Folder Path -->
                                            <Button Grid.Column="0"
                                                    Command="{Binding OpenDownloadFolderCommand}"
                                                    ToolTip="{Binding DownloadPathDisplay}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="FolderChip"
                                                                Background="Transparent"
                                                                CornerRadius="6"
                                                                Padding="4,3">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                    <Path Data="M2,5 A2,2 0 0 1 4,3 H8 L10,5 H18 A2,2 0 0 1 20,7 V17 A2,2 0 0 1 18,19 H4 A2,2 0 0 1 2,17 Z"
                                                                          Fill="Transparent"
                                                                          Stroke="{StaticResource SlateTextBrush}"
                                                                          StrokeThickness="1.6" />
                                                                </Viewbox>
                                                                <TextBlock Text="{DynamicResource DownloadFolder}"
                                                                           FontSize="9.5" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           Margin="0,0,7,0"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock x:Name="FolderText"
                                                                           Text="{Binding DownloadPathDisplay}"
                                                                           FontSize="11.5"
                                                                           Foreground="#D0D5DD"
                                                                           MaxWidth="420"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="FolderChip" Property="Background" Value="{StaticResource CardBgHoverBrush}" />
                                                                <Setter TargetName="FolderText" Property="Foreground" Value="{StaticResource PureWhiteBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Task & Queue Control Buttons -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Queue Priority / Reorder Controls (when Queued) -->
                                                <Button Content="{DynamicResource DownloadForceStart}"
                                                        Command="{Binding ForceStartDownloadCommand}"
                                                        ToolTip="{DynamicResource DownloadForceStartTooltip}"
                                                        Visibility="{Binding IsQueued, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource DownloadGhostButtonStyle}"
                                                        Height="32" Padding="11,0" Margin="0,0,6,0" />

                                                <Button Content="↑"
                                                        Command="{Binding MoveQueueUpCommand}"
                                                        ToolTip="{DynamicResource DownloadMoveUpTooltip}"
                                                        Visibility="{Binding IsQueued, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource DownloadGhostButtonStyle}"
                                                        Width="30" Height="32" Padding="0" Margin="0,0,4,0" />

                                                <Button Content="↓"
                                                        Command="{Binding MoveQueueDownCommand}"
                                                        ToolTip="{DynamicResource DownloadMoveDownTooltip}"
                                                        Visibility="{Binding IsQueued, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource DownloadGhostButtonStyle}"
                                                        Width="30" Height="32" Padding="0" Margin="0,0,7,0" />

                                                <!-- Pause Button (Active or Queued) -->
                                                <Button Content="{DynamicResource DownloadPause}"
                                                        Height="32" Padding="14,0" Margin="0,0,7,0"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding PauseCommand}"
                                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />

                                                <!-- Resume Button (Paused) -->
                                                <Button Content="{DynamicResource DownloadResume}"
                                                        Height="32" Padding="15,0" Margin="0,0,7,0"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Command="{Binding ResumeCommand}"
                                                        Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />

                                                <!-- Retry Button (Error) -->
                                                <Button Content="{DynamicResource DownloadRetry}"
                                                        Height="32" Padding="15,0" Margin="0,0,7,0"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Command="{Binding RetryDownloadCommand}"
                                                        Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}" />

                                                <!-- Play Button (Completed) -->
                                                <Button Content="{Binding PlayButtonText}"
                                                        Height="32" Padding="16,0" Margin="0,0,7,0"
                                                        Style="{StaticResource PlayButtonStyle}"
                                                        Command="{Binding PlayCommand}"
                                                        Visibility="{Binding IsCompletedDownload, Converter={StaticResource BoolToVis}}" />

                                                <!-- Open Folder Button -->
                                                <Button Content="{DynamicResource DownloadOpenFolderBtn}"
                                                        ToolTip="{DynamicResource DownloadOpenFolderTooltip}"
                                                        Height="32" Padding="11,0" Margin="0,0,7,0"
                                                        Style="{StaticResource DownloadGhostButtonStyle}"
                                                        Command="{Binding OpenDownloadFolderCommand}" />

                                                <!-- Details Drawer Toggle -->
                                                <Button Content="{DynamicResource DownloadTaskDetailsToggle}"
                                                        Height="32" Padding="11,0" Margin="0,0,7,0"
                                                        Style="{StaticResource DownloadGhostButtonStyle}"
                                                        Command="{Binding ToggleTaskDetailsCommand}" />

                                                <!-- Dismiss Completed Item (without deleting files) -->
                                                <Button Content="{DynamicResource DownloadDismiss}"
                                                        Height="32" Padding="12,0"
                                                        Style="{StaticResource DownloadGhostButtonStyle}"
                                                        Command="{Binding DismissCompletedDownloadCommand}"
                                                        Visibility="{Binding IsCompletedDownload, Converter={StaticResource BoolToVis}}" />

                                                <!-- Cancel / Remove Download (Active, Queued, Paused, Error) -->
                                                <Button Content="{DynamicResource DownloadRemove}"
                                                        Height="32" Padding="13,0"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Command="{Binding RemoveDownloadCommand}"
                                                        Visibility="{Binding IsCompletedDownload, Converter={StaticResource InverseBoolToVis}}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- ── ROW 5: Expandable Technical Details Drawer ── -->
                                        <Border Grid.Row="5"
                                                Margin="0,12,0,0"
                                                Background="#D90E0E0E"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0"
                                                CornerRadius="9"
                                                Padding="14,10"
                                                Visibility="{Binding IsTaskDetailsExpanded, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource DownloadProtocolLabel}"
                                                               FontSize="9.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding SourceProtocolDisplay}"
                                                               Margin="0,3,0,0" FontSize="11.5"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{DynamicResource DownloadPackageTypeLabel}"
                                                               FontSize="9.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding VersionTypeDisplay}"
                                                               Margin="0,3,0,0" FontSize="11.5"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                                    <TextBlock Text="{DynamicResource DownloadTargetInstallPath}"
                                                               FontSize="9.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding InstallPath}"
                                                               Margin="0,3,0,0" FontSize="11.5"
                                                               Foreground="#D0D5DD"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding InstallPath}" />
                                                </StackPanel>

                                                <Button Grid.Column="3"
                                                        Content="{DynamicResource DownloadOpenGameCard}"
                                                        Command="{Binding OpenDetailsCommand}"
                                                        Style="{StaticResource DownloadGhostButtonStyle}"
                                                        Height="28" Padding="11,0"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty State (No Downloads at all) -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0" CornerRadius="16" Padding="44,36"
                    Visibility="{Binding HasDownloadTasks, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                    <Border Width="56" Height="56" CornerRadius="28"
                            Background="{StaticResource CardBgHoverBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M12,3 L12,15 M7,10 L12,15 L17,10 M4,18 V20 H20 V18"
                                  Fill="Transparent" Stroke="{StaticResource SlateTextBrush}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Border>
                    <TextBlock Text="{DynamicResource DownloadsEmptyTitle}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource DownloadsEmptyHint}"
                               Margin="0,8,0,18" FontSize="12.5"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <Button Content="{DynamicResource DownloadAddTorrentButton}"
                            Command="{Binding AddTorrentFileCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Padding="18,8" />
                </StackPanel>
            </Border>

            <!-- Empty Filter/Search State (Downloads exist, but filter matched 0) -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0" CornerRadius="16" Padding="40,32"
                    Visibility="{Binding IsDownloadsFilterEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="380">
                    <TextBlock Text="{DynamicResource DownloadsFilterEmptyTitle}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource DownloadsFilterEmptyHint}"
                               Margin="0,8,0,16" FontSize="12"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <Button Content="{DynamicResource DownloadsResetFilters}"
                            Command="{Binding ClearDownloadsSearchCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Padding="16,7" />
                </StackPanel>
            </Border>

            <!-- Drag-over highlight overlay -->
            <Border x:Name="DragOverlay"
                    Visibility="Collapsed"
                    Background="#CC191919"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="16">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Path Data="M12,2 L12,15 M7,10 L12,15 L17,10 M4,18 V21 H20 V18"
                              Fill="Transparent" Stroke="{DynamicResource AccentHoverBrush}" StrokeThickness="1.8"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Viewbox>
                    <TextBlock Text="{DynamicResource DownloadDropTorrentRelease}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentHoverBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
