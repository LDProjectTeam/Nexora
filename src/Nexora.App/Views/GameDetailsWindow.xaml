<Window x:Class="Nexora.App.Views.GameDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource GameDetailsTitle}"
        Icon="{DynamicResource NexoraAppIcon}"
        Width="960"
        Height="720"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ── Palette ─────────────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="SuccessBrushAlt" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="WarningBrushAlt" Color="#F59E0B" />

        <!-- ── Typography ──────────────────────────────────────────────────── -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="CapsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="SpecLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SpecValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- ── Cards ───────────────────────────────────────────────────────── -->
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style x:Key="ChipBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="0,0,5,5" />
        </Style>

        <!-- ── Buttons ─────────────────────────────────────────────────────── -->
        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}" />

        <Style x:Key="HeroActionButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Background" Value="#66101820" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="Foreground" Value="#F4F8FF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Height" Value="34" />
        </Style>

        <Style x:Key="PrimaryCtaStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="Height" Value="44" />
        </Style>

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBgHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PureWhiteBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7F1D1D" />
                    <Setter Property="Foreground" Value="{StaticResource PureWhiteBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#9AA6B8" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBgHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBgHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <!-- ══ Title bar ════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="N" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BgDarkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="NEXORA" Margin="9,0,0,0" VerticalAlignment="Center"
                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="12,0" />
                    <TextBlock Text="{DynamicResource GameDetailsHeaderTitle}" VerticalAlignment="Center"
                               FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowControlButtonStyle}" Content="&#xE921;"
                            Click="Minimize_Click" ToolTip="{DynamicResource GameDetailsMinimize}" />
                    <Button Style="{StaticResource WindowControlButtonStyle}" Content="&#xE922;"
                            Click="Maximize_Click" ToolTip="{DynamicResource GameDetailsMaximize}" />
                    <Button Style="{StaticResource CloseWindowButtonStyle}" Content="&#xE8BB;"
                            Click="CloseWindow_Click" ToolTip="{DynamicResource GameDetailsClose}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Body ═════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly"
                      Background="Transparent">
            <StackPanel Margin="20,16,20,20">

                <!-- ── Hero ───────────────────────────────────────────────── -->
                <Border Height="216" CornerRadius="8" ClipToBounds="True" Background="{StaticResource SidebarBgBrush}">
                    <Grid>
                        <!-- Image background -->
                        <Border Visibility="{Binding HasHeroImage, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding HeroImageUrl, Converter={StaticResource StringToImage}}"
                                            Stretch="UniformToFill" />
                            </Border.Background>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.45" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>

                        <!-- Placeholder when there is no artwork -->
                        <Grid Visibility="{Binding HasHeroImage, Converter={StaticResource InverseBoolToVis}}">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#292929" Offset="0" />
                                    <GradientStop Color="#191919" Offset="1" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="N" FontSize="96" FontWeight="Bold" Foreground="#343434"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="NEXORA" FontSize="12" FontWeight="Bold" Foreground="#454545"
                                           HorizontalAlignment="Center" Margin="0,-8,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Readability gradients -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#40111111" Offset="0.42" />
                                    <GradientStop Color="#F2111111" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#D9111111" Offset="0" />
                                    <GradientStop Color="#00111111" Offset="0.72" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Hero actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,18,18,0">
                            <Button Style="{StaticResource HeroActionButtonStyle}"
                                    Command="{Binding CopyTitleCommand}"
                                    ToolTip="{DynamicResource GameDetailsCopyTitle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource GameDetailsCopyTitle}" Margin="7,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource HeroActionButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding OpenSteamCommand}"
                                    Visibility="{Binding CanOpenSteam, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{DynamicResource GameDetailsOpenSteam}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Steam" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource HeroActionButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="{DynamicResource GameDetailsRefresh}">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>

                        <!-- Hero content -->
                        <Grid Margin="26,20,26,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="1" MaxWidth="700" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="{StaticResource CardBgHoverBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                                            CornerRadius="5" Padding="10,4" Margin="0,0,8,0"
                                            Visibility="{Binding HasBuildType, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding BuildTypeDisplay}" FontSize="11" FontWeight="Bold"
                                                   Foreground="#E7E7E7" />
                                    </Border>
                                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                                            CornerRadius="5" Padding="10,4" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                     Fill="{Binding State, Converter={StaticResource StateToColor}}" />
                                            <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                                            CornerRadius="5" Padding="10,4"
                                            Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{DynamicResource GameDetailsSourceShort}" />
                                            <Run Text="{Binding SourceDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding Name}"
                                           FontSize="36"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PureWhiteBrush}"
                                           TextWrapping="Wrap"
                                           MaxHeight="100"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.55" />
                                    </TextBlock.Effect>
                                </TextBlock>

                                <TextBlock Text="{Binding ShortDescription}"
                                           Margin="0,8,0,0"
                                           FontSize="13"
                                           LineHeight="19"
                                           Foreground="{StaticResource TextDimBrush}"
                                           TextWrapping="Wrap"
                                           MaxHeight="58"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasShortDescription, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="{Binding HeroMetaDisplay}"
                                           Margin="0,10,0,0"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding HasHeroMeta, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── Key stats ──────────────────────────────────────────── -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CapsLabelStyle}"
                                       Text="{DynamicResource GameDetailsDownloadSizeLabel}" />
                            <TextBlock Style="{StaticResource StatValueStyle}" Margin="0,4,0,0"
                                       Text="{Binding DownloadSizeDisplay}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                       Text="{DynamicResource GameDetailsDownloadSizeHint}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CapsLabelStyle}"
                                       Text="{DynamicResource GameDetailsInstalledSizeLabel}" />
                            <TextBlock Style="{StaticResource StatValueStyle}" Margin="0,4,0,0"
                                       Text="{Binding InstalledSizeDisplay}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                       Text="{DynamicResource GameDetailsInstalledSizeHint}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CapsLabelStyle}"
                                       Text="{DynamicResource GameDetailsVersionLabel}" />
                            <TextBlock Style="{StaticResource StatValueStyle}" Margin="0,4,0,0"
                                       Text="{Binding VersionDisplay}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                       Text="{DynamicResource GameDetailsVersionHint}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CapsLabelStyle}"
                                       Text="{DynamicResource GameDetailsBuildTypeLabel}" />
                            <TextBlock Style="{StaticResource StatValueStyle}" Margin="0,4,0,0"
                                       Text="{Binding BuildTypeDisplay}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" Text="{Binding BuildTypeSubtext}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Tabs ───────────────────────────────────────────────── -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                            CornerRadius="11" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource GameDetailsTabOverview}"
                                    Command="{Binding SelectOverviewTabCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverviewTabSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Background" Value="{StaticResource CardBgHoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{DynamicResource GameDetailsTabSpecs}"
                                    Command="{Binding SelectSpecsTabCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSpecsTabSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Background" Value="{StaticResource CardBgHoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{DynamicResource GameDetailsTabStorage}"
                                    Command="{Binding SelectStorageTabCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStorageTabSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Background" Value="{StaticResource CardBgHoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ProgressBar Width="54" Height="3" IsIndeterminate="True" Margin="0,0,10,0"
                                     Background="{StaticResource BorderBrush}" Foreground="{DynamicResource AccentBrush}"
                                     Visibility="{Binding IsSteamLoading, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding SteamStatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                    </StackPanel>
                </Grid>

                <!-- ══ Tab: Overview ════════════════════════════════════════ -->
                <Grid Margin="0,14,0,0"
                      Visibility="{Binding IsOverviewTabSelected, Converter={StaticResource BoolToVis}}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverviewTabSelected}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.22" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Description -->
                    <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="{DynamicResource GameDetailsSectionDescription}" />
                                <Border HorizontalAlignment="Right" Background="#151F2B" BorderBrush="#26374A"
                                        BorderThickness="1" CornerRadius="5" Padding="9,3"
                                        Visibility="{Binding HasSteamDescription, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding DescriptionSourceLabel}" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                            </Grid>

                            <TextBlock Text="{DynamicResource GameDetailsEnglishFallback}" Margin="0,8,0,0"
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsEnglishDescriptionFallback, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding FullDescription}"
                                       Margin="0,12,0,0"
                                       FontSize="13.5"
                                       LineHeight="22"
                                       Foreground="{StaticResource TextDimBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasFullDescription, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{DynamicResource GameDetailsNoDescription}"
                                       Margin="0,12,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasFullDescription, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- About + Steam -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource PanelCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="{DynamicResource GameDetailsSectionAbout}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsReleaseDate}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               Text="{Binding ReleaseDateOrDash}" />
                                </Grid>

                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsDeveloperLabel}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               Text="{Binding DeveloperDisplay}" />
                                </Grid>

                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsPublisherLabel}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               Text="{Binding PublisherDisplay}" />
                                </Grid>

                                <TextBlock Style="{StaticResource CapsLabelStyle}" Margin="0,16,0,8"
                                           Text="{DynamicResource DetailCategories}"
                                           Visibility="{Binding HasGenres, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding Genres}"
                                              Visibility="{Binding HasGenres, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ChipBorderStyle}">
                                                <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource GhostButtonStyle}" Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding OpenSteamCommand}"
                                        Visibility="{Binding CanOpenSteam, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource GameDetailsOpenSteam}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Steam unavailable -->
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,14,0,0"
                                Visibility="{Binding ShowSteamUnavailable, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="#241E14">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding SteamUnavailableTitle}" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SteamUnavailableText}" Margin="0,10,0,0"
                                           FontSize="12" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <Button Style="{StaticResource GhostButtonStyle}" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Command="{Binding RefreshCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource GameDetailsRetry}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Steam details -->
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,14,0,0"
                                Visibility="{Binding HasSteamMetadata, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Steam" />
                                    <TextBlock Text="{Binding SteamStatusText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>

                                <Grid Margin="0,14,0,0"
                                      Visibility="{Binding HasSteamPlatforms, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsPlatforms}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               FontSize="12.5" Text="{Binding SteamPlatformsDisplay}" />
                                </Grid>

                                <Grid Margin="0,10,0,0"
                                      Visibility="{Binding HasSteamLanguages, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsLanguages}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                               Text="{Binding SteamLanguagesDisplay}" />
                                </Grid>

                                <Grid Margin="0,10,0,0"
                                      Visibility="{Binding HasSteamMetacritic, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}" Text="Metacritic" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               Foreground="#6EE7B7" Text="{Binding SteamMetacriticDisplay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ══ Tab: Specs ═══════════════════════════════════════════ -->
                <Grid Margin="0,14,0,0"
                      Visibility="{Binding IsSpecsTabSelected, Converter={StaticResource BoolToVis}}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSpecsTabSelected}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.22" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,14"
                                Background="#161108" BorderBrush="#3A2B10"
                                Visibility="{Binding ShowLookupWarning, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock Text="{Binding LookupStatusText}" Margin="10,0,0,0" FontSize="12"
                                           LineHeight="18" Foreground="#D6B27A" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Install and version -->
                            <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="{DynamicResource GameDetailsSectionInstall}" />

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="142" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SpecLabelStyle}"
                                                   Text="{DynamicResource DetailDownloadSize}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                                   Text="{Binding DownloadSizeDisplay}" />
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="142" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SpecLabelStyle}"
                                                   Text="{DynamicResource DetailInstallSize}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                                   Text="{Binding InstalledSizeDisplay}" />
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="142" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SpecLabelStyle}"
                                                   Text="{DynamicResource DetailVersion}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                                   Text="{Binding VersionDisplay}" />
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="142" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SpecLabelStyle}"
                                                   Text="{DynamicResource DetailType}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                                   Foreground="#E7E7E7" Text="{Binding BuildTypeDisplay}" />
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="142" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SpecLabelStyle}"
                                                   Text="{DynamicResource DetailSource}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                                   Text="{Binding SourceDisplay}" />
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="142" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SpecLabelStyle}"
                                                   Text="{DynamicResource GameDetailsReleaseAuthor}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                                   Text="{Binding ReleaseAuthorDisplay}" />
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="142" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SpecLabelStyle}"
                                                   Text="{DynamicResource GameDetailsProtocol}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                                   Text="{Binding ProtocolDisplay}" />
                                    </Grid>
                                    <Grid Margin="0,12,0,0"
                                          Visibility="{Binding HasSeeders, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="142" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SpecLabelStyle}"
                                                   Text="{DynamicResource GameDetailsSeedersPeersLabel}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                                   Foreground="{StaticResource SuccessBrush}" Text="{Binding SeedersPeersDisplay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Release and disk -->
                            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="{DynamicResource GameDetailsSectionRelease}" />

                                    <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding HasReleaseTitle, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource CapsLabelStyle}"
                                                   Text="{DynamicResource DetailOriginalName}" />
                                        <TextBlock Text="{Binding ReleaseTitleDisplay}" Margin="0,6,0,0"
                                                   FontSize="12.5" LineHeight="18" Foreground="{StaticResource TextDimBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="142" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SpecLabelStyle}"
                                                   Text="{DynamicResource GameDetailsReleaseUploaded}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                                   Text="{Binding ReleasePublishDateDisplay}" />
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="142" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SpecLabelStyle}"
                                                   Text="{DynamicResource GameDetailsLanguage}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                                   Text="{Binding ReleaseLanguageDisplay}" />
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14" />

                                    <TextBlock Style="{StaticResource CapsLabelStyle}"
                                               Text="{DynamicResource GameDetailsDiskSpaceTitle}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="142" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SpecLabelStyle}"
                                                   Text="{DynamicResource GameDetailsRequiredSpace}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                                   Text="{Binding RequiredDiskSpaceDisplay}" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0"
                                          Visibility="{Binding HasDiskSpaceInfo, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="142" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SpecLabelStyle}"
                                                   Text="{DynamicResource GameDetailsAvailableSpace}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                                   Text="{Binding AvailableDiskSpaceDisplay}" />
                                    </Grid>
                                    <Border Background="#121A15" BorderBrush="#1E3A2A" BorderThickness="1"
                                            CornerRadius="8" Padding="10,7" Margin="0,12,0,0"
                                            Visibility="{Binding HasDiskSpaceInfo, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding SpaceStatusDisplay}" FontSize="11.5"
                                                   TextWrapping="Wrap" Foreground="#6EE7B7" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Official Steam data -->
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,14,0,0"
                                Visibility="{Binding HasSteamMetadata, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="{DynamicResource GameDetailsSectionOfficial}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource CapsLabelStyle}"
                                                   Text="{DynamicResource GameDetailsReleaseDate}" />
                                        <TextBlock Style="{StaticResource SpecValueStyle}" Margin="0,5,0,0"
                                                   Text="{Binding SteamReleaseDateDisplay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource CapsLabelStyle}"
                                                   Text="{DynamicResource DetailDeveloper}" />
                                        <TextBlock Style="{StaticResource SpecValueStyle}" Margin="0,5,0,0"
                                                   Text="{Binding SteamDeveloperDisplay}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource CapsLabelStyle}"
                                                   Text="{DynamicResource DetailPublisher}" />
                                        <TextBlock Style="{StaticResource SpecValueStyle}" Margin="0,5,0,0"
                                                   Text="{Binding SteamPublisherDisplay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource CapsLabelStyle}"
                                                   Text="{DynamicResource DetailCategories}" />
                                        <TextBlock Style="{StaticResource SpecValueStyle}" Margin="0,5,0,0"
                                                   FontSize="12.5" Text="{Binding SteamGenresDisplay}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,14,0,0"
                                            Visibility="{Binding HasSteamPlatforms, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource CapsLabelStyle}"
                                               Text="{DynamicResource GameDetailsPlatforms}" />
                                    <TextBlock Style="{StaticResource SpecValueStyle}" Margin="0,5,0,0"
                                               FontSize="12.5" Text="{Binding SteamPlatformsDisplay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- System requirements -->
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,14,0,0"
                                Visibility="{Binding HasSteamRequirements, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="{DynamicResource GameDetailsSectionRequirements}" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Visibility="{Binding HasMinimumRequirements, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource CapsLabelStyle}"
                                                   Text="{DynamicResource GameDetailsMinimumRequirements}" />
                                        <TextBlock Text="{Binding MinimumRequirementsDisplay}" Margin="0,7,0,0"
                                                   FontSize="12" LineHeight="18" Foreground="#AEBACB"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Visibility="{Binding HasRecommendedRequirements, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource CapsLabelStyle}"
                                                   Text="{DynamicResource GameDetailsRecommendedRequirements}" />
                                        <TextBlock Text="{Binding RecommendedRequirementsDisplay}" Margin="0,7,0,0"
                                                   FontSize="12" LineHeight="18" Foreground="#AEBACB"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ══ Tab: Storage ═════════════════════════════════════════ -->
                <Grid Margin="0,14,0,0"
                      Visibility="{Binding IsStorageTabSelected, Converter={StaticResource BoolToVis}}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStorageTabSelected}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.22" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource PanelCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="{DynamicResource GameDetailsSectionStatus}" />
                                    <Border HorizontalAlignment="Right" CornerRadius="5" Padding="10,4"
                                            Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{Binding State, Converter={StaticResource StateToColor}}" />
                                            <TextBlock Text="{Binding StatusText}" Margin="7,0,0,0" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource CapsLabelStyle}"
                                               Text="{DynamicResource GameDetailsInstallPath}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding InstallPathDisplay}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                                Content="&#xE8C8;" Margin="8,0,0,0"
                                                Command="{Binding CopyInstallPathCommand}"
                                                ToolTip="{DynamicResource GameDetailsCopyPath}" />
                                    </Grid>
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsStorageLibrary}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               FontSize="12.5" Text="{Binding LibraryPathDisplay}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding LibraryPathDisplay}" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsStorageInstalledVersion}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               Text="{Binding InstalledVersionDisplay}" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsStorageInstalledAt}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               Text="{Binding InstalledAtDisplay}" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsStorageLastUpdated}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               Text="{Binding LastUpdatedDisplay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Progress -->
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,14,0,0"
                                Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="{DynamicResource GameDetailsStorageProgress}" />
                                    <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                                <ProgressBar Height="8" Margin="0,14,0,0" Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                             Background="{StaticResource BorderBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" />
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="{Binding DownloadSpeedDisplay}" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding RemainingTimeDisplay}" HorizontalAlignment="Right"
                                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Actions -->
                    <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="{DynamicResource GameDetailsSectionActions}" />

                            <!-- Not installed -->
                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="{DynamicResource GameDetailsStorageNotInstalled}"
                                           FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <Button Style="{StaticResource PrimaryCtaStyle}" Margin="0,16,0,0"
                                        Command="{Binding PrimaryActionCommand}"
                                        Content="{Binding PrimaryActionLabel}" />
                            </StackPanel>

                            <!-- Installed actions -->
                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch"
                                        Command="{Binding OpenFolderCommand}" Margin="0,0,0,9">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource GameDetailsOpenFolder}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch"
                                        Command="{Binding VerifyCommand}" Margin="0,0,0,9">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource GameDetailsVerify}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch"
                                        Command="{Binding UpdateCommand}" Margin="0,0,0,9">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource GameDetailsUpdate}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource PrimaryCtaStyle}" Margin="0,8,0,0"
                                        Command="{Binding PrimaryActionCommand}"
                                        Content="{Binding PrimaryActionLabel}" />
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />

                            <TextBlock Style="{StaticResource CapsLabelStyle}"
                                       Text="{DynamicResource GameDetailsFileHealth}" />
                            <TextBlock Text="{DynamicResource GameDetailsFileHealthHint}" Margin="0,7,0,0"
                                       FontSize="11.5" LineHeight="17" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ══ Footer ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Notification / hint -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="  •  " FontSize="12" Foreground="#3D4656" />
                        <TextBlock Text="{Binding BuildTypeDisplay}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>

                    <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                            CornerRadius="5" Padding="12,6"
                            Visibility="{Binding HasNotificationMessage, Converter={StaticResource BoolToVis}}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="NotificationTransform" />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNotificationMessage}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.18" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                     From="8" To="0" Duration="0:0:0.18" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="#34D399" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NotificationMessage}" Margin="8,0,0,0" FontSize="12"
                                       Foreground="#A7F3D0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButtonStyle}" Height="42" MinWidth="150"
                            Command="{Binding CopySummaryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource GameDetailsCopyAll}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}" Height="42" MinWidth="104"
                            Margin="10,0,0,0" Command="{Binding CloseCommand}"
                            Content="{DynamicResource GameDetailsClose}" />

                    <Button Style="{StaticResource PrimaryCtaStyle}" MinWidth="210" Margin="14,0,0,0"
                            Command="{Binding PrimaryActionCommand}"
                            Content="{Binding PrimaryActionLabel}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

