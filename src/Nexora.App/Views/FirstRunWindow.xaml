<Window x:Class="Nexora.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FirstRunTitle}"
        Icon="{StaticResource NexoraAppIcon}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Border CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0" Background="#111316">
        <StackPanel>

            <!-- Title bar -->
            <Border Background="#171A1F" CornerRadius="12,12,0,0" Padding="20,14"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                        <Path Data="M12,2 L21,7 L12,12 L3,7 Z M3,7 V17 L12,22 L21,17 V7 M12,12 V22"
                              Fill="Transparent" Stroke="#AEB7C4" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Viewbox>
                    <TextBlock Text="{DynamicResource FirstRunHeading}" FontSize="15"
                               FontWeight="SemiBold" Foreground="{StaticResource PureWhiteBrush}"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <StackPanel Margin="28,24,28,20">

                <!-- Welcome text -->
                <TextBlock Text="{DynamicResource FirstRunWelcome}"
                           FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PureWhiteBrush}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource FirstRunDescription}" TextWrapping="Wrap"
                           FontSize="13" Foreground="{StaticResource TextLightBrush}" LineHeight="20" Margin="0,0,0,20" />

                <!-- Path row -->
                <TextBlock Text="{DynamicResource FirstRunLibraryFolder}" FontSize="12"
                           Foreground="{StaticResource TextSoftBrush}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#1A1D22" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0" CornerRadius="7" Padding="12,9"
                            Margin="0,0,10,0">
                        <TextBlock x:Name="PathText" Text="" Foreground="{StaticResource PureWhiteBrush}"
                                   FontSize="13" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="1" Content="{DynamicResource ActionBrowse}"
                            Click="BrowseButton_Click"
                            FocusVisualStyle="{StaticResource NexoraFocusVisualStyle}"
                            Padding="16,9"
                            Background="#2B3240" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                            Foreground="{StaticResource PureWhiteBrush}" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2B3240"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource PureWhiteBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#3A4560"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Hint about drive root -->
                <TextBlock Text="{DynamicResource FirstRunDriveHint}" TextWrapping="Wrap"
                           FontSize="11" Foreground="#7A8899" LineHeight="16" Margin="0,0,0,24" />

                <!-- Free disk space indicator -->
                <Border x:Name="DiskInfoBorder" Background="#1A1D22" CornerRadius="8"
                        Padding="14,10" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource FirstRunFreeSpace}" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="FreeSpaceText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PureWhiteBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Action buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="{DynamicResource FirstRunUseDefault}"
                            Click="UseDefaultButton_Click"
                            FocusVisualStyle="{StaticResource NexoraFocusVisualStyle}"
                            HorizontalAlignment="Left"
                            Padding="16,10"
                            Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                            Foreground="{StaticResource TextLightBrush}" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1E2330"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="1" Content="{DynamicResource FirstRunStart}"
                            x:Name="ConfirmButton"
                            Click="ConfirmButton_Click"
                            Padding="28,10"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource SurfaceDeepBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#0EA877"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

            </StackPanel>
        </StackPanel>
    </Border>
</Window>
