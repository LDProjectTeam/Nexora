<UserControl x:Class="Nexora.App.Views.GameCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Nexora.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GameCardViewModel}">

    <Border Background="{StaticResource CardBgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0"
            CornerRadius="12"
            Margin="0"
            ClipToBounds="True"
            SizeChanged="CardBorder_SizeChanged"
            Cursor="Hand"
            PreviewMouseLeftButtonUp="Card_PreviewMouseLeftButtonUp">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#202020" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#292929" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Cover area can adapt to each card layout -->
                <RowDefinition Height="*" />   <!-- Game Details -->
                <RowDefinition Height="Auto" /><!-- Actions & Progress -->
            </Grid.RowDefinitions>

            <!-- 1. Cover Image Area -->
            <Grid Grid.Row="0" Height="{Binding ArtworkHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <!-- Fallback Gradient Background -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#303030" Offset="0" />
                            <GradientStop Color="#171717" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <!-- Thin controller outline used as the cover fallback. -->
                    <Viewbox Width="34" Height="34" Opacity="0.42" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding HasCoverArtwork, Converter={StaticResource InverseBoolToVis}}">
                        <Path Data="M3,8 A3,3 0 0 1 6,5 H14 A3,3 0 0 1 17,8 L19,13 A2,2 0 0 1 16,15 L13,12 H7 L4,15 A2,2 0 0 1 1,13 Z M6,8 V12 M4,10 H8 M14,9 H14.1 M16,11 H16.1"
                              Fill="Transparent" Stroke="#9A9A9A" StrokeThickness="1.4"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Viewbox>
                </Border>

                <!-- Actual Image if exists -->
                <Image Source="{Binding CoverUrl, Converter={StaticResource StringToImage}, ConverterParameter=Card}"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

                <!-- Subtle bottom shadow gradient on cover -->
                <Border VerticalAlignment="Bottom" Height="50">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#B3111111" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Status Badge (Top-Right) -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="8"
                        Background="#D9151515"
                        BorderBrush="{Binding State, Converter={StaticResource StateToColor}}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="7,3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6"
                                 Fill="{Binding State, Converter={StaticResource StateToColor}}"
                                 Margin="0,0,5,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Category tag (Bottom-Left) -->
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="8"
                        Background="#A6000000"
                        CornerRadius="4"
                        Padding="6,2">
                    <TextBlock Text="{Binding CategoriesDisplay}"
                               Foreground="#CBD5E1"
                               FontSize="10"
                               FontWeight="Medium"
                               MaxWidth="140"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>

            <!-- 2. Game Details -->
            <StackPanel Grid.Row="1" Margin="12,5,12,3">
                <!-- Game Name -->
                <TextBlock Text="{Binding Name}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,8" />

                <!-- Short description -->
                <TextBlock Text="{Binding Description}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           LineHeight="15"
                           TextWrapping="Wrap"
                           MaxHeight="24"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Description}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Metadata Row: Size and Version -->
                <Grid VerticalAlignment="Bottom" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource CardSize}" Foreground="#64748B" FontSize="11" />
                        <TextBlock Text="{Binding SizeDisplay}" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="{Binding Version}" Foreground="#64748B" FontSize="11" />
                    </StackPanel>
                </Grid>

            </StackPanel>

            <!-- 3. Actions and Download Progress Section -->
            <Border Grid.Row="2"
                    Background="#1A1A1A"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,8">
                <StackPanel>
                    <!-- Progress Bar (shown when downloading / verifying / installing) -->
                    <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,6">
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="{Binding PhaseText}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Left" />
                            <TextBlock HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold">
                                <Run Text="{Binding ProgressPercent, StringFormat={}{0:F0}}" />
                                <Run Text="%" />
                            </TextBlock>
                        </Grid>

                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                     Maximum="100"
                                     Style="{StaticResource ModernProgressBar}"
                                     Height="4" />

                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="{Binding ProgressText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding SpeedText}"
                                       Foreground="#BDBDBD"
                                       FontSize="10"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- Control Buttons -->
                    <Grid>
                        <!-- 1. Install button (Not installed or Error) -->
                        <Button Content="{DynamicResource CardInstall}"
                                Command="{Binding InstallCommand}"
                                Height="32"
                                FontSize="12"
                                Padding="0"
                                Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}"
                                HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 2. Downloading controls: Pause -->
                        <Button Content="{DynamicResource DownloadPause}"
                                Height="32"
                                FontSize="12"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding PauseCommand}"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Stretch" />

                        <!-- 3. Paused controls: Resume -->
                        <Button Content="{DynamicResource DownloadResume}"
                                Height="32"
                                FontSize="12"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ResumeCommand}"
                                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Stretch" />

                        <!-- 4. Installed controls: Play + Actions Menu -->
                        <Grid Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Play button (or Running status) -->
                            <Button Grid.Column="0"
                                    Height="32"
                                    FontSize="12"
                                    Content="{Binding PlayButtonText}"
                                    Style="{StaticResource PlayButtonStyle}"
                                    Command="{Binding PlayCommand}"
                                    Margin="0,0,4,0" />

                            <!-- Context Actions (Verify, Folder, Update, Delete) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- Update button if available -->
                                <Button Content="{DynamicResource CardUpdate}"
                                        Height="32"
                                        FontSize="11"
                                        Command="{Binding UpdateCommand}"
                                        Margin="0,0,3,0"
                                        Padding="8,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="UpdateAvailable">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Open Folder -->
                                <Button ToolTip="{DynamicResource CardOpenFolder}"
                                        Height="32" Width="30"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenFolderCommand}"
                                        Margin="0,0,3,0"
                                        Padding="0">
                                    <Viewbox Width="14" Height="14">
                                        <Path Data="M3,6 A2,2 0 0 1 5,4 H8.5 L10.5,6 H19 A2,2 0 0 1 21,8 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z" Fill="Transparent"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Viewbox>
                                </Button>

                                <!-- Uninstall -->
                                <Button ToolTip="{DynamicResource CardUninstall}"
                                        Height="32" Width="30"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding UninstallCommand}"
                                        Padding="0">
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M5,7 H19 M9,7 V5 H15 V7 M7,8 L8,19.5 Q8,21 9.5,21 H14.5 Q16,21 16,19.5 L17,8 M10,11 V18 M14,11 V18" Fill="Transparent"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.7" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
