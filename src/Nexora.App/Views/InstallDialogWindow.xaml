<Window x:Class="Nexora.App.Views.InstallDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource InstallDialogTitle}"
        Icon="{StaticResource NexoraAppIcon}"
        Width="520" SizeToContent="Height" MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Border CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0" Background="#111316">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar (draggable) -->
            <Border Grid.Row="0" Background="#171A1F" CornerRadius="12,12,0,0" Padding="20,14"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                            <Path Data="M12,2 L21,7 L12,12 L3,7 Z M3,7 V17 L12,22 L21,17 V7 M12,12 V22 M7.5,4.5 L16.5,9.5"
                                  Fill="Transparent" Stroke="#AEB7C4" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                        <TextBlock Text="{DynamicResource InstallDialogTitle}" FontSize="16"
                                   FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                    <Button Width="32" Height="28" HorizontalAlignment="Right"
                            Click="CloseButton_Click" Foreground="#94A3B8"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="{DynamicResource WindowClose}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="2">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#CC3B2F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                        </Style>
                    </Button.Style>
                    <Path Data="M4,4 L20,20 M20,4 L4,20" Width="12" Height="12" Stretch="Fill"
                          Stroke="#94A3B8" StrokeThickness="1.6" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="680">
                <StackPanel Margin="20,18,20,10">

                    <!-- Loading indicator -->
                    <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" Margin="0,30,0,30">
                        <TextBlock Text="{DynamicResource InstallSearch}" FontSize="14"
                                   Foreground="#C2CAD5" HorizontalAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0"
                                     Foreground="#D5D5D5" Background="#333333" BorderThickness="0"/>
                    </StackPanel>

                    <!-- Error panel -->
                    <Border x:Name="ErrorPanel" Visibility="Collapsed"
                            Background="#3A1B1B" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource InstallGameNotFound}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#E74C3C" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ErrorText" TextWrapping="Wrap"
                                       Foreground="#CCC" FontSize="12" LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- Result panel -->
                    <StackPanel x:Name="ResultPanel" Visibility="Collapsed">

                        <!-- Game name -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource InstallGame}" FontSize="10" Foreground="#9AA5B4"
                                       FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBlock x:Name="GameTitleText" FontSize="20" FontWeight="SemiBold"
                                       Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Badges -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Background="#3A424D" CornerRadius="5" Padding="9,4" Margin="0,0,8,0">
                                <TextBlock x:Name="SourceBadge" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                            <Border x:Name="VersionTypeBorder" Background="#3A424D" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock x:Name="VersionTypeText" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                            <Border x:Name="GameVersionBorder" Visibility="Collapsed" Background="#23272E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0" CornerRadius="4" Padding="8,3">
                                <TextBlock x:Name="GameVersionText" FontSize="11" Foreground="#61AFEF" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <!-- Fast Version Switcher Bar (when both Portable and Repack are present) -->
                        <Border x:Name="VersionSwitcherBar"
                                Visibility="Collapsed"
                                Background="#16181B"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="4"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SelectPortableTabBtn"
                                        Grid.Column="0"
                                        Click="SelectPortableTabBtn_Click"
                                        Height="32"
                                        Margin="2"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="#151515"
                                        FontWeight="SemiBold"
                                        FontSize="11"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="SelectRepackTabBtn"
                                        Grid.Column="1"
                                        Click="SelectRepackTabBtn_Click"
                                        Height="32"
                                        Margin="2"
                                        Background="Transparent"
                                        Foreground="#94A3B8"
                                        FontWeight="SemiBold"
                                        FontSize="11"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <Border x:Name="NoPortablePanel"
                                Visibility="Collapsed"
                                Background="#3A2A12"
                                BorderBrush="#A87320"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,0,0,12">
                            <TextBlock x:Name="NoPortableWarningText"
                                       FontSize="12"
                                       Foreground="#FFD28A"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Secondary choice dropdown (for selecting specific repack / release) -->
                        <TextBlock x:Name="ReleaseChoiceLabel"
                                   Visibility="Collapsed"
                                   Text="{DynamicResource InstallChooseOtherRelease}"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   Margin="0,0,0,4" />
                        <ComboBox x:Name="ReleaseChoiceBox"
                                  Visibility="Collapsed"
                                  Style="{StaticResource ModernComboBox}"
                                  Height="48"
                                  Margin="0,0,0,12"
                                  SelectionChanged="ReleaseChoiceBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock Text="{Binding RawTitle}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="10"
                                                   Foreground="#94A3B8">
                                            <Run Text="{Binding SourceName}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding VersionType}" />
                                            <Run Text=" · " />
                                            <Run Text="{DynamicResource InstallSeeders}" />
                                            <Run Text=": " />
                                            <Run Text="{Binding Seeders}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border Background="#202328"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,10,0">
                                    <Path Data="M12,4 A8,8 0 1 0 12,20 A8,8 0 1 0 12,4 Z M12,10 V16" Fill="Transparent"
                                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="InstallFlowText" FontSize="12"
                                           Foreground="#C4CBD5" TextWrapping="Wrap" LineHeight="17" />
                            </Grid>
                        </Border>

                        <!-- Size info -->
                        <Border Background="#202328" CornerRadius="9" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                                    <TextBlock Text="{DynamicResource InstallDownloadSize}" FontSize="10" Foreground="#9AA5B4" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="DownloadSizeText" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                                    <TextBlock Text="{DynamicResource InstallAfterInstall}" FontSize="10" Foreground="#9AA5B4" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="InstalledSizeText" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{DynamicResource InstallSeeders}" FontSize="10" Foreground="#9AA5B4" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="SeedersText" FontSize="15" FontWeight="SemiBold" Foreground="#D5D5D5"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{DynamicResource InstallSource}" FontSize="10" Foreground="#9AA5B4" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="SourceDetailText" FontSize="13" Foreground="#D0D6E0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Disk space -->
                        <Border x:Name="DiskSpaceBorder" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                                Background="#1B3A2D">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource InstallDiskSpace}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#AEB9C7" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource InstallAvailable}" FontSize="11" Foreground="#AAA" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="AvailableSpaceText" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource InstallRequired}" FontSize="11" Foreground="#AAA" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="RequiredSpaceText" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Insufficient warning -->
                                <Border x:Name="InsufficientPanel" Visibility="Collapsed"
                                        Background="#3A1B1B" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                                    <TextBlock x:Name="MissingSpaceText"
                                               FontSize="12" Foreground="#E74C3C" FontWeight="SemiBold"
                                               TextWrapping="Wrap" LineHeight="18"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Strategy explanation -->
                        <Border x:Name="StrategyPanel" Visibility="Collapsed"
                                Background="#202328" CornerRadius="7" Padding="12,9" Margin="0,0,0,4">
                            <TextBlock x:Name="StrategyText" FontSize="11" Foreground="#B7C0CC"
                                       TextWrapping="Wrap" LineHeight="16"/>
                        </Border>

                        <!-- Source errors (non-fatal) -->
                        <Border x:Name="SourceErrorsPanel" Visibility="Collapsed"
                                Background="#2A1E00" CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                            <TextBlock x:Name="SourceErrorsText" FontSize="11" Foreground="#FFA500"
                                       TextWrapping="Wrap" LineHeight="16"/>
                        </Border>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Action buttons -->
            <Border Grid.Row="2" Background="#222222" CornerRadius="0,0,12,12" Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource InstallCancel}" Width="100" Height="36" Margin="0,0,10,0"
                            Click="CancelButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button x:Name="DownloadButton" Content="{DynamicResource InstallStartDownload}" Width="160" Height="36"
                            Click="DownloadButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
