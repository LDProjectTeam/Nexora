<UserControl x:Class="Nexora.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Nexora.App.ViewModels"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <UserControl.Resources>
        <Style x:Key="SettingsScrollViewerStyle"
               TargetType="ScrollViewer"
               BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1" Grid.Row="0"
                                       Margin="0,40,8,12"
                                       shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Opacity="0.6" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Orientation="Horizontal"
                                       Grid.Column="0" Grid.Row="1"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Opacity="0.6" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Margin" Value="0,0,0,18" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#242424" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsRowContainer" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceDarkerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D1D1D" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsHeaderIconBox" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="SettingsToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource NexoraFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="50" Height="28" Background="Transparent">
                            <Border x:Name="Track" Width="48" Height="26" HorizontalAlignment="Left"
                                    CornerRadius="13" Background="#2A2A2E" BorderBrush="#2A2A2E" BorderThickness="0" />
                            <Ellipse x:Name="Thumb" Width="18" Height="18" HorizontalAlignment="Left"
                                     Margin="4,0,0,0" Fill="#D4D4D8" VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#141414" />
                                <Setter TargetName="Thumb" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="22" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpeedPresetChipButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource NexoraFocusVisualStyle}" />
            <Setter Property="Background" Value="#232323" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#353535" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentSwatchButton" TargetType="Button">
            <Setter Property="Background" Value="#1B1B1B" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource NexoraFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="SwatchBorder" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                                <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{Binding Brush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,52,32,36" MaxWidth="1040" HorizontalAlignment="Stretch">

            <!-- Page Header -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource SettingsTitle}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource SettingsSubtitle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,5,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{DynamicResource SettingsOpenDataFolder}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenAppDataFolderCommand}"
                        VerticalAlignment="Center"
                        Height="36"
                        Padding="14,0" />
            </Grid>

            <!-- Inline Status Notification Banner -->
            <Border CornerRadius="10"
                    Padding="16,12"
                    Margin="0,0,0,18"
                    BorderThickness="1"
                    Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#14291F" />
                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Background" Value="#2D1619" />
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Content="×"
                            Command="{Binding DismissStatusCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="16"
                            Cursor="Hand"
                            Padding="6,0"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════════
                 Section 1: Appearance & Interface
                 ═══════════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource SettingsSectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsHeaderIconBox}">
                            <Viewbox Width="18" Height="18">
                                <Path Data="M12,2 A10,10 0 1 0 22,12 A2.5,2.5 0 0 1 19.5,14.5 H17 A2,2 0 0 0 15,16.5 A2,2 0 0 0 15.5,17.8 A2.5,2.5 0 0 1 13.5,22 A10,10 0 0 0 12,2 Z M7.5,10 A1.5,1.5 0 1 1 9,8.5 A1.5,1.5 0 0 1 7.5,10 Z M11.5,7.5 A1.5,1.5 0 1 1 13,6 A1.5,1.5 0 0 1 11.5,7.5 Z M16,10 A1.5,1.5 0 1 1 17.5,8.5 A1.5,1.5 0 0 1 16,10 Z"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource SettingsAppearanceTitle}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource SettingsAppearanceSubtitle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Interface Language -->
                    <Border Style="{StaticResource SettingsRowContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource SettingsLanguageTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource SettingsLanguageSubtitle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LanguageOptions}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Code"
                                      SelectedValue="{Binding SelectedLanguage, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource ModernComboBox}"
                                      AutomationProperties.Name="{DynamicResource SettingsLanguageTitle}" />
                        </Grid>
                    </Border>

                    <!-- Accent Color Swatches -->
                    <Border Style="{StaticResource SettingsRowContainer}" Margin="0">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource SettingsAccentTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource SettingsAccentSubtitle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding AccentOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource AccentSwatchButton}"
                                                Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Code}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="14" Height="14"
                                                         Fill="{Binding Brush}"
                                                         Stroke="#40FFFFFF"
                                                         StrokeThickness="1"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════════
                 Section 2: Folders & Storage
                 ═══════════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource SettingsSectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsHeaderIconBox}">
                            <Viewbox Width="18" Height="18">
                                <Path Data="M3,6 A2,2 0 0 1 5,4 H9.5 L11.5,6.5 H19 A2,2 0 0 1 21,8.5 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 Z"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource SettingsPathsTitle}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource SettingsPathsSubtitle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Default Library Path + Live Disk Space Indicator -->
                    <Border Style="{StaticResource SettingsRowContainer}" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource SettingsLibraryPath}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DriveUsageSummary}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDriveSpaceLow}" Value="True">
                                                    <Setter Property="Foreground" Value="#F87171" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <ProgressBar Value="{Binding DriveUsedPercent, Mode=OneWay}"
                                         Maximum="100"
                                         Style="{StaticResource ModernProgressBar}"
                                         Height="5"
                                         Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding DefaultInstallPath, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsInstallPathEditable}"
                                         Style="{StaticResource ModernTextBox}"
                                         Margin="0,0,8,0" />
                                <Button Grid.Column="1"
                                        Content="{DynamicResource ActionBrowse}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding BrowseInstallPathCommand}"
                                        IsEnabled="{Binding IsInstallPathEditable}"
                                        Height="40"
                                        Padding="16,0"
                                        Margin="0,0,8,0" />
                                <Button Grid.Column="2"
                                        Content="{DynamicResource SettingsOpenFolder}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenLibraryFolderCommand}"
                                        Height="40"
                                        Padding="14,0" />
                            </Grid>

                            <!-- Context hint depending on AskInstallFolderOnEachInstall -->
                            <Border CornerRadius="7" Padding="11,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AskInstallFolderOnEachInstall}" Value="True">
                                                <Setter Property="Background" Value="#292012" />
                                                <Setter Property="BorderBrush" Value="#5C4018" />
                                                <Setter Property="BorderThickness" Value="1" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AskInstallFolderOnEachInstall}" Value="False">
                                                <Setter Property="Background" Value="#141414" />
                                                <Setter Property="BorderBrush" Value="#262626" />
                                                <Setter Property="BorderThickness" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="17">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AskInstallFolderOnEachInstall}" Value="True">
                                                    <Setter Property="Foreground" Value="#FCD34D" />
                                                    <Setter Property="Text" Value="{DynamicResource SettingsAskFolderWarning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AskInstallFolderOnEachInstall}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Setter Property="Text" Value="{DynamicResource SettingsLibraryHint}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Toggle: ask folder on each install -->
                    <Border Style="{StaticResource SettingsRowContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource SettingsAskFolderTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="Medium" />
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AskInstallFolderOnEachInstall}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource SettingsAskFolderOn}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AskInstallFolderOnEachInstall}" Value="False">
                                                    <Setter Property="Text" Value="{DynamicResource SettingsAskFolderOff}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding AskInstallFolderOnEachInstall}"
                                      Style="{StaticResource SettingsToggleSwitch}"
                                      AutomationProperties.Name="{DynamicResource SettingsAskFolderTitle}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Toggle: prefer portable versions -->
                    <Border Style="{StaticResource SettingsRowContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource SettingsPreferPortableTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource SettingsPreferPortableDescription}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding PreferPortable}"
                                      Style="{StaticResource SettingsToggleSwitch}"
                                      AutomationProperties.Name="{DynamicResource SettingsPreferPortableTitle}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Cache Cleanup Row -->
                    <Border Style="{StaticResource SettingsRowContainer}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding CacheSizeSummary}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="13"
                                           FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource DownloadsTempNote}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{DynamicResource SettingsClearCache}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding ClearTempCacheCommand}"
                                    VerticalAlignment="Center"
                                    Padding="14,8" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════════
                 Section 3: Network & Downloads
                 ═══════════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource SettingsSectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsHeaderIconBox}">
                            <Viewbox Width="18" Height="18">
                                <Path Data="M12,3 V15 M7,10 L12,15 L17,10 M4,18 V20 H20 V18"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.7"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource SettingsNetworkTitle}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource SettingsNetworkSubtitle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Download Speed Limit -->
                    <Border Style="{StaticResource SettingsRowContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource SettingsDownloadLimit}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource SettingsUnlimited}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,2,0,8" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource SettingsLimitUnlimitedShort}"
                                            Style="{StaticResource SpeedPresetChipButton}"
                                            Command="{Binding SetDownloadLimitPresetCommand}"
                                            CommandParameter="0" />
                                    <Button Content="10 MB/s"
                                            Style="{StaticResource SpeedPresetChipButton}"
                                            Command="{Binding SetDownloadLimitPresetCommand}"
                                            CommandParameter="10" />
                                    <Button Content="25 MB/s"
                                            Style="{StaticResource SpeedPresetChipButton}"
                                            Command="{Binding SetDownloadLimitPresetCommand}"
                                            CommandParameter="25" />
                                    <Button Content="50 MB/s"
                                            Style="{StaticResource SpeedPresetChipButton}"
                                            Command="{Binding SetDownloadLimitPresetCommand}"
                                            CommandParameter="50" />
                                    <Button Content="100 MB/s"
                                            Style="{StaticResource SpeedPresetChipButton}"
                                            Command="{Binding SetDownloadLimitPresetCommand}"
                                            CommandParameter="100" />
                                </WrapPanel>
                            </StackPanel>
                            <Grid Grid.Column="1" Width="140" VerticalAlignment="Center">
                                <TextBox Text="{Binding MaxDownloadSpeedMbps, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}"
                                         Padding="14,0,48,0"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"
                                         DataObject.Pasting="NumericOnly_Pasting"
                                         AutomationProperties.Name="{DynamicResource SettingsDownloadLimit}" />
                                <TextBlock Text="{DynamicResource SettingsSpeedUnitMbps}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Upload Speed Limit -->
                    <Border Style="{StaticResource SettingsRowContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource SettingsUploadLimit}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource SettingsUnlimited}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,2,0,8" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource SettingsLimitUnlimitedShort}"
                                            Style="{StaticResource SpeedPresetChipButton}"
                                            Command="{Binding SetUploadLimitPresetCommand}"
                                            CommandParameter="0" />
                                    <Button Content="5 MB/s"
                                            Style="{StaticResource SpeedPresetChipButton}"
                                            Command="{Binding SetUploadLimitPresetCommand}"
                                            CommandParameter="5" />
                                    <Button Content="10 MB/s"
                                            Style="{StaticResource SpeedPresetChipButton}"
                                            Command="{Binding SetUploadLimitPresetCommand}"
                                            CommandParameter="10" />
                                    <Button Content="25 MB/s"
                                            Style="{StaticResource SpeedPresetChipButton}"
                                            Command="{Binding SetUploadLimitPresetCommand}"
                                            CommandParameter="25" />
                                </WrapPanel>
                            </StackPanel>
                            <Grid Grid.Column="1" Width="140" VerticalAlignment="Center">
                                <TextBox Text="{Binding MaxUploadSpeedMbps, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}"
                                         Padding="14,0,48,0"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"
                                         DataObject.Pasting="NumericOnly_Pasting"
                                         AutomationProperties.Name="{DynamicResource SettingsUploadLimit}" />
                                <TextBlock Text="{DynamicResource SettingsSpeedUnitMbps}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Toggle: Allow Seeding -->
                    <Border Style="{StaticResource SettingsRowContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource SettingsAllowSeedingTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource SettingsAllowSeedingDescription}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding AllowSeeding}"
                                      Style="{StaticResource SettingsToggleSwitch}"
                                      AutomationProperties.Name="{DynamicResource SettingsAllowSeedingTitle}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Toggle: Auto-Check Game Updates -->
                    <Border Style="{StaticResource SettingsRowContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource SettingsAutoCheckUpdatesTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource SettingsAutoCheckUpdatesDescription}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding AutoCheckUpdates}"
                                      Style="{StaticResource SettingsToggleSwitch}"
                                      AutomationProperties.Name="{DynamicResource SettingsAutoCheckUpdatesTitle}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource SurfaceDarkerBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0" CornerRadius="8" Padding="12,10">
                        <TextBlock Text="{DynamicResource SettingsTorrentHint}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   LineHeight="16" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════════
                 Section 4: Behavior & System
                 ═══════════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource SettingsSectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsHeaderIconBox}">
                            <Viewbox Width="18" Height="18">
                                <Path Data="M4,5 H20 A1,1 0 0 1 21,6 V16 A1,1 0 0 1 20,17 H4 A1,1 0 0 1 3,16 V6 A1,1 0 0 1 4,5 Z M8,20 H16 M12,17 V20"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource SettingsBehaviorTitle}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource SettingsBehaviorSubtitle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Launch with Windows -->
                    <Border Style="{StaticResource SettingsRowContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource SettingsLaunchWithWindowsTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource SettingsLaunchWithWindowsDescription}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding LaunchWithWindows}"
                                      Style="{StaticResource SettingsToggleSwitch}"
                                      AutomationProperties.Name="{DynamicResource SettingsLaunchWithWindowsTitle}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Minimize to tray on close -->
                    <Border Style="{StaticResource SettingsRowContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource SettingsMinimizeToTrayTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource SettingsMinimizeToTrayDescription}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding MinimizeToTray}"
                                      Style="{StaticResource SettingsToggleSwitch}"
                                      AutomationProperties.Name="{DynamicResource SettingsMinimizeToTrayTitle}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Minimize to tray on game launch -->
                    <Border Style="{StaticResource SettingsRowContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource SettingsMinimizeOnGameLaunchTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource SettingsMinimizeOnGameLaunchDescription}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding MinimizeOnGameLaunch}"
                                      Style="{StaticResource SettingsToggleSwitch}"
                                      AutomationProperties.Name="{DynamicResource SettingsMinimizeOnGameLaunchTitle}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Restore launcher on game exit -->
                    <Border Style="{StaticResource SettingsRowContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource SettingsRestoreOnGameExitTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource SettingsRestoreOnGameExitDescription}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding RestoreOnGameExit}"
                                      Style="{StaticResource SettingsToggleSwitch}"
                                      AutomationProperties.Name="{DynamicResource SettingsRestoreOnGameExitTitle}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Allow multiple games to run -->
                    <Border Style="{StaticResource SettingsRowContainer}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource SettingsAllowMultipleTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource SettingsAllowMultipleDescription}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding AllowMultipleGames}"
                                      Style="{StaticResource SettingsToggleSwitch}"
                                      AutomationProperties.Name="{DynamicResource SettingsAllowMultipleTitle}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════════
                 Section 5: Catalog Sources
                 ═══════════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource SettingsSectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingsHeaderIconBox}">
                            <Viewbox Width="18" Height="18">
                                <Path Data="M12,3 C7,3 3,4.8 3,7 V17 C3,19.2 7,21 12,21 C17,21 21,19.2 21,17 V7 C21,4.8 17,3 12,3 Z M3,7 C3,9.2 7,11 12,11 C17,11 21,9.2 21,7 M3,12 C3,14.2 7,16 12,16 C17,16 21,14.2 21,12"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource SettingsSourcesTitle}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource SettingsSourcesSubtitle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Built-in sources status -->
                    <TextBlock Text="{DynamicResource SettingsBuiltInSourcesLabel}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,0,0,8" />
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                                CornerRadius="8" Padding="12,7" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource BuiltInCatalogName}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                                CornerRadius="8" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Rutor Game Index"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Add new custom source -->
                    <TextBlock Text="{DynamicResource SettingsCustomSourcesLabel}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <TextBox x:Name="CatalogUrlInputBox"
                                     Text="{Binding NewCatalogUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddCatalogUrlCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="{DynamicResource SettingsSourceUrlPlaceholder}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       Margin="14,0,14,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NewCatalogUrl}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=CatalogUrlInputBox}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="1"
                                Content="{DynamicResource ActionBrowse}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding BrowseCatalogFileCommand}"
                                Height="40"
                                Padding="14,0"
                                Margin="0,0,8,0" />
                        <Button Grid.Column="2"
                                Content="{DynamicResource SettingsAddSource}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddCatalogUrlCommand}"
                                Height="40"
                                Padding="18,0" />
                    </Grid>

                    <!-- Empty state for custom sources -->
                    <Border Background="#1E1E1E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                            CornerRadius="9" Padding="14,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AdditionalCatalogUrls.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource TextSecondaryBrush}"
                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{DynamicResource SettingsNoSources}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Custom sources list -->
                    <ItemsControl ItemsSource="{Binding AdditionalCatalogUrls}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceDarkerBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="7" Height="7"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.RemoveCatalogUrlCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="8,5"
                                                Margin="10,0,0,0">
                                            <Path Data="M4,4 L16,16 M16,4 L4,16" Width="11" Height="11" Stretch="Fill"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════════
                 Footer Action Bar: Reset & Save
                 ═══════════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource SettingsSectionCard}" Padding="20,16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{DynamicResource SettingsSavePrompt}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource SettingsSaveHint}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{DynamicResource SettingsResetButton}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ResetSettingsCommand}"
                            Height="42"
                            Padding="18,0"
                            Margin="0,0,10,0" />
                    <Button Grid.Column="2"
                            Content="{DynamicResource SettingsSaveButton}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveSettingsCommand}"
                            MinWidth="190"
                            Height="42"
                            Padding="22,0" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
