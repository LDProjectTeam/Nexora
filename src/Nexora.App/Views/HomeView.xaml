<UserControl x:Class="Nexora.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:views="clr-namespace:Nexora.App.Views"
             xmlns:vm="clr-namespace:Nexora.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <UserControl.Resources>
        <Style x:Key="FeaturedCarouselButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#D8FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource NexoraFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FeaturedCarouselDotButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource NexoraFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hydra-inspired top bar with Nexora navigation and search. -->
        <Grid Grid.Row="0" Margin="24,0,128,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource HomeTitle}"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <Grid Grid.Column="1" Width="270" VerticalAlignment="Center">
                <TextBox x:Name="HomeSearchBox"
                         Height="38"
                         Style="{StaticResource ModernTextBox}"
                         shell:WindowChrome.IsHitTestVisibleInChrome="True"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Padding="38,0,12,0"
                         VerticalContentAlignment="Center"
                         FontSize="13">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ExecuteOnlineSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Viewbox Width="15" Height="15" Margin="12,0,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Data="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 M13,13 L19,19" Fill="Transparent"
                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" />
                </Viewbox>
                <TextBlock Text="{DynamicResource HomeSearchPlaceholder}" FontSize="13" Margin="38,0,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           IsHitTestVisible="False" Foreground="{StaticResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchQuery}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=HomeSearchBox}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <ScrollViewer x:Name="CatalogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="CatalogScrollViewer_ScrollChanged">
            <StackPanel>
                <!-- Featured game -->
                <Border x:Name="FeaturedHero" Height="294" Margin="0,0,0,0" ClipToBounds="True" Background="#151515">
                    <Grid x:Name="HeroRoot">
                        <!-- Designed backdrop behind the artwork so the hero is never an empty black block
                             while art loads or when a game has neither a banner nor a cover. -->
                        <Grid x:Name="FeaturedFallbackBackdrop" IsHitTestVisible="False">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#232A34" Offset="0" />
                                    <GradientStop Color="#181D24" Offset="0.55" />
                                    <GradientStop Color="#0F1216" Offset="1" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Image Source="/Assets/NEXORA_icon_light.ico" Width="230" Height="230"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,96,0"
                                   Stretch="Uniform" Opacity="0.055" />
                        </Grid>
                        <Grid x:Name="CurrentFeaturedArtwork">
                            <Image x:Name="FeaturedHeroImage"
                                   Source="{Binding FeaturedGame.FeaturedImageUrl, Converter={StaticResource StringToImage}, NotifyOnTargetUpdated=True}"
                                   ImageFailed="FeaturedHeroImage_ImageFailed"
                                   TargetUpdated="FeaturedHeroImage_TargetUpdated">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Stretch" Value="UniformToFill" />
                                        <Setter Property="Opacity" Value="0.8" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FeaturedGame.HasBannerArtwork}" Value="False">
                                                <Setter Property="Opacity" Value="0.85" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Grid>
                        <Grid x:Name="PreviousFeaturedArtwork" Opacity="0" IsHitTestVisible="False">
                            <Image x:Name="PreviousHeroImage" Stretch="UniformToFill" Opacity="0.8" />
                        </Grid>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#12111111" Offset="0" />
                                    <GradientStop Color="#22111111" Offset="0.48" />
                                    <GradientStop Color="#F2111111" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel x:Name="FeaturedContent" VerticalAlignment="Bottom" Opacity="1">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Margin" Value="76,24,76,24" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FeaturedGame.HasBannerArtwork}" Value="False">
                                            <Setter Property="Margin" Value="76,24,205,24" />
                                        </DataTrigger>
                                        <!-- Do not show the offline/empty caption while the
                                             first slide is still loading. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding FeaturedGame}" Value="{x:Null}" />
                                                <Condition Binding="{Binding IsLoading}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="FeaturedContentTranslation" />
                            </StackPanel.RenderTransform>
                            <TextBlock Text="{DynamicResource FeaturedRecommended}"
                                       FontSize="12" FontWeight="Medium"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Left" Margin="0,0,0,12" />
                            <TextBlock x:Name="FeaturedTitleText" Text="Каталог"
                                       FontSize="32" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FeaturedDescriptionText"
                                       Text="Ваша игровая библиотека и новые открытия — в одном месте."
                                       FontSize="13" Foreground="#D1D5DB" TextTrimming="CharacterEllipsis" MaxWidth="700"
                                       HorizontalAlignment="Left" Margin="0,5,0,16" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource ActionInstallPlay}" Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"
                                        Command="{Binding FeaturedGame.PrimaryActionCommand}" Margin="0,0,10,0" />
                                <Button Content="{DynamicResource ActionDetails}" Style="{StaticResource SecondaryButtonStyle}" Padding="18,10"
                                        Command="{Binding FeaturedGame.OpenDetailsCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Snapshot of the outgoing caption, faded over the new one so the
                             carousel never shows a blank/dimmed caption while switching. -->
                        <Image x:Name="PreviousCaptionSnapshot"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Stretch="Fill"
                               Opacity="0"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <Button HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"
                                Style="{StaticResource FeaturedCarouselButton}"
                                Command="{Binding PreviousFeaturedGameCommand}"
                                Visibility="{Binding HasFeaturedCarousel, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="Предыдущая рекомендуемая игра">
                            <Path Data="M14,4 L6,12 L14,20" Width="12" Height="18" Stretch="Fill"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                Style="{StaticResource FeaturedCarouselButton}"
                                Command="{Binding NextFeaturedGameCommand}"
                                Visibility="{Binding HasFeaturedCarousel, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="Следующая рекомендуемая игра">
                            <Path Data="M6,4 L14,12 L6,20" Width="12" Height="18" Stretch="Fill"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <ItemsControl HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,76,18"
                                      ItemsSource="{Binding FeaturedSlideIndicators}"
                                      Visibility="{Binding HasFeaturedCarousel, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FeaturedCarouselDotButton}"
                                            Command="{Binding DataContext.SelectFeaturedGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Index}"
                                            ToolTip="{Binding AutomationName}"
                                            AutomationProperties.Name="{Binding AutomationName}">
                                        <Border CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Width" Value="7" />
                                                    <Setter Property="Background" Value="#A6FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Width" Value="20" />
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Discovery filters and existing catalogue controls -->
                <Grid Margin="15,18,15,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center">
                        <Button Height="38" Padding="14,0" Margin="0,0,8,0"
                                Command="{Binding SetDiscoveryTabCommand}" CommandParameter="В тренде">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDiscoveryTab}" Value="В тренде">
                                            <Setter Property="Background" Value="#414141" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Data="M2,16 L7,11 L10,14 L18,5 M13,5 H18 V10" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Viewbox>
                                <TextBlock Text="{DynamicResource TabTrending}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Height="38" Padding="14,0" Margin="0,0,8,0"
                                Command="{Binding SetDiscoveryTabCommand}" CommandParameter="Топ загрузок">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDiscoveryTab}" Value="Топ загрузок">
                                            <Setter Property="Background" Value="#414141" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Data="M12,2 V15 M7,10 L12,15 L17,10 M4,18 V21 H20 V18" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Viewbox>
                                <TextBlock Text="{DynamicResource TabTopDownloads}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Height="38" Padding="14,0" Margin="0,0,8,0"
                                Command="{Binding SetDiscoveryTabCommand}" CommandParameter="По алфавиту">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDiscoveryTab}" Value="По алфавиту">
                                            <Setter Property="Background" Value="#414141" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Data="M2,19 L7,5 L12,19 M4,14 H10 M15,5 H22 L15,12 H22 M15,19 H22" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Viewbox>
                                <TextBlock Text="{DynamicResource TabAlphabetical}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Height="38" Padding="14,0"
                                Command="{Binding SurpriseMeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Data="M10,1 L12,7 L18,9 L12,11 L10,17 L8,11 L2,9 L8,7 Z M17,14 L18,17 L21,18 L18,19 L17,22 L16,19 L13,18 L16,17 Z" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.3" StrokeLineJoin="Round" />
                                </Viewbox>
                                <TextBlock Text="{DynamicResource TabSurprise}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button ToolTip="{DynamicResource ActionRefresh}"
                                ToolTipService.Placement="Top"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="112" Height="38"
                                Command="{Binding RefreshCatalogCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="15" Height="15" Margin="0,0,7,0">
                                    <Path Data="M18,7 A8,8 0 0 0 4,5 L2,7 M2,3 V7 H6 M2,13 A8,8 0 0 0 16,15 L18,13 M18,17 V13 H14" Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Viewbox>
                                <TextBlock Text="{DynamicResource ActionRefresh}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding SectionTitle}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="21,0,15,14" />

                <Border Visibility="{Binding IsSearchingOnline, Converter={StaticResource BoolToVis}}"
                        Background="#202020" CornerRadius="8" Padding="18,12" Margin="24,0,24,16"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="80" Height="4" Margin="0,0,14,0"
                                     Foreground="{DynamicResource AccentBrush}" Background="#303030" BorderThickness="0" />
                        <TextBlock Text="{DynamicResource SearchUpdating}" FontSize="13" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding DisplayedCatalogGames}" Margin="15,0,0,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:GameCardControl Width="{Binding CatalogCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Height="300" Margin="6,0,1,16" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{DynamicResource LoadingMoreGames}"
                           Visibility="{Binding IsLoadingMoreGames, Converter={StaticResource BoolToVis}}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,20" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.RowSpan="2" Panel.ZIndex="20"
              Visibility="{Binding IsSurpriseCaseOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#D9000000" />
            <Border Width="930" Height="390" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#202020" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0" CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SurpriseCaseTitle}" Foreground="White"
                                       FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource SurpriseCaseDescription}" Foreground="#AEB7C4"
                                       FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32"
                                Content="×" FontSize="19" Padding="0" Click="SurpriseCaseClose_Click"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <Border x:Name="SurpriseCaseViewport" Grid.Row="1" Height="218"
                            Background="#171717" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                            CornerRadius="12" ClipToBounds="True">
                        <Grid ClipToBounds="True">
                            <Canvas ClipToBounds="True">
                                <ItemsControl x:Name="SurpriseCaseItemsControl" ItemsSource="{Binding SurpriseRollItems}"
                                              Canvas.Left="0" Canvas.Top="8">
                                    <ItemsControl.RenderTransform>
                                        <TranslateTransform x:Name="SurpriseCaseStripTransform" />
                                    </ItemsControl.RenderTransform>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="184" Height="194" Margin="8,0"
                                                    Background="#242424" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                                                    CornerRadius="9" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding CoverUrl, Converter={StaticResource StringToImage}, ConverterParameter=Card}"
                                                           Stretch="UniformToFill" Opacity="0.82" />
                                                    <Border VerticalAlignment="Bottom" Height="90">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#00101318" Offset="0" />
                                                                <GradientStop Color="#F2101318" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Bottom" Margin="12,8,12,13">
                                                        <TextBlock Text="Nexora Drop" Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="9" FontWeight="SemiBold" Margin="0,0,0,5" />
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13"
                                                                   FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                            <Border Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    Background="{DynamicResource AccentBrush}" Opacity="0.95" IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <Button Grid.Row="2" Content="{DynamicResource SurpriseCaseSkip}"
                            HorizontalAlignment="Right" Margin="0,18,0,0" Padding="18,8"
                            Click="SurpriseCaseSkip_Click" Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
