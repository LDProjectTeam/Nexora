<UserControl x:Class="Nexora.App.Views.GameDetailsOverviewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Nexora;component/Views/GameDetailsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                <Grid Margin="0,14,0,0"
                      Visibility="{Binding IsOverviewTabSelected, Converter={StaticResource BoolToVis}}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverviewTabSelected}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.22" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Description -->
                    <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="{DynamicResource GameDetailsSectionDescription}" />
                                <Border HorizontalAlignment="Right" Background="#151F2B" BorderBrush="#26374A"
                                        BorderThickness="1" CornerRadius="5" Padding="9,3"
                                        Visibility="{Binding HasSteamDescription, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding DescriptionSourceLabel}" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                            </Grid>

                            <TextBlock Text="{DynamicResource GameDetailsEnglishFallback}" Margin="0,8,0,0"
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsEnglishDescriptionFallback, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding FullDescription}"
                                       Margin="0,12,0,0"
                                       FontSize="13.5"
                                       LineHeight="22"
                                       Foreground="{StaticResource TextDimBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasFullDescription, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{DynamicResource GameDetailsNoDescription}"
                                       Margin="0,12,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasFullDescription, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- About + Steam -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource PanelCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="{DynamicResource GameDetailsSectionAbout}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsReleaseDate}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               Text="{Binding ReleaseDateOrDash}" />
                                </Grid>

                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsDeveloperLabel}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               Text="{Binding DeveloperDisplay}" />
                                </Grid>

                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsPublisherLabel}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               Text="{Binding PublisherDisplay}" />
                                </Grid>

                                <TextBlock Style="{StaticResource CapsLabelStyle}" Margin="0,16,0,8"
                                           Text="{DynamicResource DetailCategories}"
                                           Visibility="{Binding HasGenres, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding Genres}"
                                              Visibility="{Binding HasGenres, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ChipBorderStyle}">
                                                <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource GhostButtonStyle}" Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding OpenSteamCommand}"
                                        Visibility="{Binding CanOpenSteam, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource GameDetailsOpenSteam}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Steam unavailable -->
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,14,0,0"
                                Visibility="{Binding ShowSteamUnavailable, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="#241E14">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding SteamUnavailableTitle}" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SteamUnavailableText}" Margin="0,10,0,0"
                                           FontSize="12" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <Button Style="{StaticResource GhostButtonStyle}" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Command="{Binding RefreshCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource GameDetailsRetry}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Steam details -->
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,14,0,0"
                                Visibility="{Binding HasSteamMetadata, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Steam" />
                                    <TextBlock Text="{Binding SteamStatusText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>

                                <Grid Margin="0,14,0,0"
                                      Visibility="{Binding HasSteamPlatforms, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsPlatforms}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               FontSize="12.5" Text="{Binding SteamPlatformsDisplay}" />
                                </Grid>

                                <Grid Margin="0,10,0,0"
                                      Visibility="{Binding HasSteamLanguages, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsLanguages}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                               Text="{Binding SteamLanguagesDisplay}" />
                                </Grid>

                                <Grid Margin="0,10,0,0"
                                      Visibility="{Binding HasSteamMetacritic, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}" Text="Metacritic" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               Foreground="#6EE7B7" Text="{Binding SteamMetacriticDisplay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
</UserControl>