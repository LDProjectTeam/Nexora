<UserControl x:Class="Vellum.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Vellum.App.Views"
             xmlns:vm="clr-namespace:Vellum.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <UserControl.Resources>
        <!-- Compact filter chips used above the library grid. -->
        <Style x:Key="LibraryFilterChipStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource VellumFocusVisualStyle}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PureWhiteBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small transparent button inside the search field. -->
        <Style x:Key="LibraryInlineButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource VellumFocusVisualStyle}" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PureWhiteBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24"
          AllowDrop="True"
          PreviewDragOver="Library_PreviewDragOver"
          PreviewDragLeave="Library_PreviewDragLeave"
          PreviewDrop="Library_PreviewDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header: title plus a compact, live summary of the library. -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource LibraryTitle}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource LibrarySubtitle}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12.5" Margin="0,4,0,0" />
            </StackPanel>

            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Margin="16,0,0,0">
                <!-- Installed games -->
                <Border Background="{StaticResource CardBgBrush}"
                        CornerRadius="8" Padding="11,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"
                                 Fill="{StaticResource SlateTextBrush}" />
                        <TextBlock Text="{DynamicResource LibraryStatGames}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding LibraryTotalCount}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Total measured size on disk -->
                <Border Background="{StaticResource CardBgBrush}"
                        CornerRadius="8" Padding="11,6" Margin="0,0,6,0"
                        Visibility="{Binding HasLibrarySize, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource LibraryStatSize}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding LibrarySizeText}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Pending updates -->
                <Border Background="{StaticResource CardBgBrush}"
                        CornerRadius="8" Padding="11,6"
                        Visibility="{Binding HasLibraryUpdates, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"
                                 Fill="{StaticResource WarningBrush}" />
                        <TextBlock Text="{DynamicResource LibraryStatUpdates}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding LibraryUpdateCount}"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Grid>

        <!-- Search, filters, sorting and shortcut import. -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0"
                CornerRadius="12"
                Padding="14,12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Library-scoped search -->
                    <Grid Grid.Column="0" HorizontalAlignment="Stretch">
                        <TextBox x:Name="LibViewSearchBox"
                                 Height="38"
                                 BorderThickness="0"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="{Binding LibrarySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="38,0,34,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="12.5" />
                        <Viewbox Width="14" Height="14" Margin="13,0,0,0" VerticalAlignment="Center"
                                 HorizontalAlignment="Left" IsHitTestVisible="False">
                            <Path Data="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 M13,13 L19,19" Fill="Transparent"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" />
                        </Viewbox>
                        <TextBlock Text="{DynamicResource LibrarySearchPlaceholder}"
                                   FontSize="12.5" Margin="38,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LibrarySearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=LibViewSearchBox}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Style="{StaticResource LibraryInlineButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                Command="{Binding ClearLibrarySearchCommand}"
                                ToolTip="{DynamicResource LibraryClearSearch}"
                                Visibility="{Binding HasLibrarySearchQuery, Converter={StaticResource BoolToVis}}">
                            <Viewbox Width="9" Height="9">
                                <Path Data="M2,2 L12,12 M12,2 L2,12" Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Button>
                    </Grid>

                    <!-- Sorting -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <TextBlock Text="{DynamicResource LibrarySortLabel}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <ComboBox Width="150" Height="38" SelectedValuePath="Tag"
                                  SelectedValue="{Binding LibrarySortBy}"
                                  Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Tag="Name" Content="{DynamicResource SettingsSortName}" />
                            <ComboBoxItem Tag="Size" Content="{DynamicResource SettingsSortSize}" />
                            <ComboBoxItem Tag="Status" Content="{DynamicResource SettingsSortStatus}" />
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="{DynamicResource LibraryAddShortcut}"
                            ToolTip="{DynamicResource LibraryShortcutDropHint}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="38" Padding="14,0" Margin="12,0,0,0"
                            Command="{Binding ImportShortcutCommand}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding SetLibraryFilterCommand}" CommandParameter="All">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LibraryFilterChipStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLibraryFilterAll}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource PureWhiteBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource LibraryFilterAll}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding LibraryTotalCount}" Margin="6,0,0,0" Opacity="0.55"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SetLibraryFilterCommand}" CommandParameter="Installed">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LibraryFilterChipStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLibraryFilterInstalled}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource PureWhiteBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource LibraryFilterInstalled}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding LibraryInstalledCount}" Margin="6,0,0,0" Opacity="0.55"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SetLibraryFilterCommand}" CommandParameter="Downloads">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LibraryFilterChipStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLibraryFilterDownloads}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource PureWhiteBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource LibraryFilterDownloads}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding LibraryDownloadCount}" Margin="6,0,0,0" Opacity="0.55"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SetLibraryFilterCommand}" CommandParameter="Updates">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LibraryFilterChipStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLibraryFilterUpdates}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource PureWhiteBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource LibraryFilterUpdates}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding LibraryUpdateCount}" Margin="6,0,0,0" Opacity="0.55"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="12,0,0,0" IsHitTestVisible="False">
                        <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                            <Path Data="M10,13 A5,5 0 0 0 17.54,13.54 L20.54,10.54 A5,5 0 0 0 13.47,3.47 L11.75,5.18 M14,11 A5,5 0 0 0 6.46,10.46 L3.46,13.46 A5,5 0 0 0 10.53,20.53 L12.24,18.82"
                                  Fill="Transparent" Stroke="{StaticResource SlateMutedBrush}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                        <TextBlock Text="{DynamicResource LibraryDropHintShort}"
                                   Foreground="{StaticResource SlateMutedBrush}"
                                   FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Library grid and its empty / drag states. -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="LibraryScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="LibraryScrollViewer_ScrollChanged">
                <ItemsControl ItemsSource="{Binding LibraryGames}" Margin="-8,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:GameCardControl Width="{Binding LibraryCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   MinHeight="214" ArtworkHeight="105" Margin="3,0,3,12" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Library is genuinely empty -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0" CornerRadius="16" Padding="44,36"
                    Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="430">
                    <Border Width="60" Height="60" CornerRadius="30"
                            Background="{StaticResource CardBgHoverBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Viewbox Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M1.5,16.5 H16.5 M3.5,4 H6.5 V16.5 H3.5 Z M7.5,6 H10.5 V16.5 H7.5 Z M12,4.8 L14.7,5.9 L16.8,16.5 H13.8 Z M4.5,6.5 H5.5 M8.5,8.5 H9.5"
                                  Fill="Transparent" Stroke="{StaticResource SlateTextBrush}" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Border>
                    <TextBlock Text="{DynamicResource LibraryEmptyTitle}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource LibraryEmptyHint}"
                               Margin="0,8,0,20" FontSize="12.5"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{DynamicResource LibraryOpenCatalog}"
                                Command="{Binding NavigateHomeCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="18,8" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource LibraryAddShortcut}"
                                Command="{Binding ImportShortcutCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="18,8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Search or filter matched nothing -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0" CornerRadius="16" Padding="40,32"
                    Visibility="{Binding IsLibraryFilterEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="390">
                    <TextBlock Text="{DynamicResource LibraryNoResultsTitle}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource LibraryNoResultsHint}"
                               Margin="0,8,0,16" FontSize="12"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <Button Content="{DynamicResource LibraryResetFilters}"
                            Command="{Binding ClearLibraryFiltersCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Padding="16,7" />
                </StackPanel>
            </Border>

            <!-- Drag-and-drop target for .lnk shortcuts -->
            <Border x:Name="LibraryDropOverlay"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Background="#CC191919"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="16">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <Viewbox Width="46" Height="46" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Path Data="M10,13 A5,5 0 0 0 17.54,13.54 L20.54,10.54 A5,5 0 0 0 13.47,3.47 L11.75,5.18 M14,11 A5,5 0 0 0 6.46,10.46 L3.46,13.46 A5,5 0 0 0 10.53,20.53 L12.24,18.82"
                              Fill="Transparent" Stroke="{DynamicResource AccentHoverBrush}"
                              StrokeThickness="1.8" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Viewbox>
                    <TextBlock Text="{DynamicResource LibraryDropOverlay}"
                               FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource AccentHoverBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
