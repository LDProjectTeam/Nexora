<UserControl x:Class="Vellum.App.Views.GameDetailsStorageTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Vellum;component/Views/GameDetailsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                <Grid Margin="0,14,0,0"
                      Visibility="{Binding IsStorageTabSelected, Converter={StaticResource BoolToVis}}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStorageTabSelected}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.22" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource PanelCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="{DynamicResource GameDetailsSectionStatus}" />
                                    <Border HorizontalAlignment="Right" CornerRadius="5" Padding="10,4"
                                            Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{Binding State, Converter={StaticResource StateToColor}}" />
                                            <TextBlock Text="{Binding StatusText}" Margin="7,0,0,0" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource CapsLabelStyle}"
                                               Text="{DynamicResource GameDetailsInstallPath}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding InstallPathDisplay}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                                Content="&#xE8C8;" Margin="8,0,0,0"
                                                Command="{Binding CopyInstallPathCommand}"
                                                ToolTip="{DynamicResource GameDetailsCopyPath}" />
                                    </Grid>
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsStorageLibrary}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               FontSize="12.5" Text="{Binding LibraryPathDisplay}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding LibraryPathDisplay}" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsStorageInstalledVersion}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               Text="{Binding InstalledVersionDisplay}" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsStorageInstalledAt}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               Text="{Binding InstalledAtDisplay}" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SpecLabelStyle}"
                                               Text="{DynamicResource GameDetailsStorageLastUpdated}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SpecValueStyle}"
                                               Text="{Binding LastUpdatedDisplay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Progress -->
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,14,0,0"
                                Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="{DynamicResource GameDetailsStorageProgress}" />
                                    <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                                <ProgressBar Height="8" Margin="0,14,0,0" Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                             Background="{StaticResource BorderBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" />
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="{Binding DownloadSpeedDisplay}" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding RemainingTimeDisplay}" HorizontalAlignment="Right"
                                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Actions -->
                    <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="{DynamicResource GameDetailsSectionActions}" />

                            <!-- Not installed -->
                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="{DynamicResource GameDetailsStorageNotInstalled}"
                                           FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <Button Style="{StaticResource PrimaryCtaStyle}" Margin="0,16,0,0"
                                        Command="{Binding PrimaryActionCommand}"
                                        Content="{Binding PrimaryActionLabel}" />
                            </StackPanel>

                            <!-- Installed actions -->
                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch"
                                        Command="{Binding OpenFolderCommand}" Margin="0,0,0,9">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource GameDetailsOpenFolder}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch"
                                        Command="{Binding VerifyCommand}" Margin="0,0,0,9">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource GameDetailsVerify}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch"
                                        Command="{Binding UpdateCommand}" Margin="0,0,0,9">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource GameDetailsUpdate}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource PrimaryCtaStyle}" Margin="0,8,0,0"
                                        Command="{Binding PrimaryActionCommand}"
                                        Content="{Binding PrimaryActionLabel}" />
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />

                            <TextBlock Style="{StaticResource CapsLabelStyle}"
                                       Text="{DynamicResource GameDetailsFileHealth}" />
                            <TextBlock Text="{DynamicResource GameDetailsFileHealthHint}" Margin="0,7,0,0"
                                       FontSize="11.5" LineHeight="17" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
</UserControl>