<Window x:Class="Vellum.App.Views.GameDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Vellum.App.Views"
        Title="{DynamicResource GameDetailsTitle}"
        Icon="{DynamicResource VellumAppIcon}"
        Width="960"
        Height="720"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

<Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Vellum;component/Views/GameDetailsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <!-- ══ Title bar ════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="V" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BgDarkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="VELLUM" Margin="9,0,0,0" VerticalAlignment="Center"
                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="12,0" />
                    <TextBlock Text="{DynamicResource GameDetailsHeaderTitle}" VerticalAlignment="Center"
                               FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowControlButtonStyle}" Content="&#xE921;"
                            Click="Minimize_Click" ToolTip="{DynamicResource GameDetailsMinimize}" />
                    <Button Style="{StaticResource WindowControlButtonStyle}" Content="&#xE922;"
                            Click="Maximize_Click" ToolTip="{DynamicResource GameDetailsMaximize}" />
                    <Button Style="{StaticResource CloseWindowButtonStyle}" Content="&#xE8BB;"
                            Click="CloseWindow_Click" ToolTip="{DynamicResource GameDetailsClose}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Body ═════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly"
                      Background="Transparent">
            <StackPanel Margin="20,16,20,20">

                <!-- ── Hero ───────────────────────────────────────────────── -->
                <Border Height="216" CornerRadius="8" ClipToBounds="True" Background="{StaticResource SidebarBgBrush}">
                    <Grid>
                        <!-- Image background -->
                        <Border Visibility="{Binding HasHeroImage, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding HeroImageUrl, Converter={StaticResource StringToImage}}"
                                            Stretch="UniformToFill" />
                            </Border.Background>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.45" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>

                        <!-- Placeholder when there is no artwork -->
                        <Grid Visibility="{Binding HasHeroImage, Converter={StaticResource InverseBoolToVis}}">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#292929" Offset="0" />
                                    <GradientStop Color="#191919" Offset="1" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="V" FontSize="96" FontWeight="Bold" Foreground="#343434"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="VELLUM" FontSize="12" FontWeight="Bold" Foreground="#454545"
                                           HorizontalAlignment="Center" Margin="0,-8,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Readability gradients -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#40111111" Offset="0.42" />
                                    <GradientStop Color="#F2111111" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#D9111111" Offset="0" />
                                    <GradientStop Color="#00111111" Offset="0.72" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Hero actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,18,18,0">
                            <Button Style="{StaticResource HeroActionButtonStyle}"
                                    Command="{Binding CopyTitleCommand}"
                                    ToolTip="{DynamicResource GameDetailsCopyTitle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource GameDetailsCopyTitle}" Margin="7,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource HeroActionButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding OpenSteamCommand}"
                                    Visibility="{Binding CanOpenSteam, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{DynamicResource GameDetailsOpenSteam}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Steam" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource HeroActionButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="{DynamicResource GameDetailsRefresh}">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>

                        <!-- Hero content -->
                        <Grid Margin="26,20,26,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="1" MaxWidth="700" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="{StaticResource CardBgHoverBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                                            CornerRadius="5" Padding="10,4" Margin="0,0,8,0"
                                            Visibility="{Binding HasBuildType, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding BuildTypeDisplay}" FontSize="11" FontWeight="Bold"
                                                   Foreground="#E7E7E7" />
                                    </Border>
                                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                                            CornerRadius="5" Padding="10,4" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                     Fill="{Binding State, Converter={StaticResource StateToColor}}" />
                                            <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                                            CornerRadius="5" Padding="10,4"
                                            Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{DynamicResource GameDetailsSourceShort}" />
                                            <Run Text="{Binding SourceDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding Name}"
                                           FontSize="36"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PureWhiteBrush}"
                                           TextWrapping="Wrap"
                                           MaxHeight="100"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.55" />
                                    </TextBlock.Effect>
                                </TextBlock>

                                <TextBlock Text="{Binding ShortDescription}"
                                           Margin="0,8,0,0"
                                           FontSize="13"
                                           LineHeight="19"
                                           Foreground="{StaticResource TextDimBrush}"
                                           TextWrapping="Wrap"
                                           MaxHeight="58"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasShortDescription, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="{Binding HeroMetaDisplay}"
                                           Margin="0,10,0,0"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding HasHeroMeta, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── Key stats ──────────────────────────────────────────── -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CapsLabelStyle}"
                                       Text="{DynamicResource GameDetailsDownloadSizeLabel}" />
                            <TextBlock Style="{StaticResource StatValueStyle}" Margin="0,4,0,0"
                                       Text="{Binding DownloadSizeDisplay}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                       Text="{DynamicResource GameDetailsDownloadSizeHint}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CapsLabelStyle}"
                                       Text="{DynamicResource GameDetailsInstalledSizeLabel}" />
                            <TextBlock Style="{StaticResource StatValueStyle}" Margin="0,4,0,0"
                                       Text="{Binding InstalledSizeDisplay}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                       Text="{DynamicResource GameDetailsInstalledSizeHint}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CapsLabelStyle}"
                                       Text="{DynamicResource GameDetailsVersionLabel}" />
                            <TextBlock Style="{StaticResource StatValueStyle}" Margin="0,4,0,0"
                                       Text="{Binding VersionDisplay}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                       Text="{DynamicResource GameDetailsVersionHint}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CapsLabelStyle}"
                                       Text="{DynamicResource GameDetailsBuildTypeLabel}" />
                            <TextBlock Style="{StaticResource StatValueStyle}" Margin="0,4,0,0"
                                       Text="{Binding BuildTypeDisplay}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" Text="{Binding BuildTypeSubtext}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Tabs ───────────────────────────────────────────────── -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                            CornerRadius="11" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource GameDetailsTabOverview}"
                                    Command="{Binding SelectOverviewTabCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverviewTabSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Background" Value="{StaticResource CardBgHoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{DynamicResource GameDetailsTabSpecs}"
                                    Command="{Binding SelectSpecsTabCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSpecsTabSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Background" Value="{StaticResource CardBgHoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{DynamicResource GameDetailsTabStorage}"
                                    Command="{Binding SelectStorageTabCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStorageTabSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Background" Value="{StaticResource CardBgHoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ProgressBar Width="54" Height="3" IsIndeterminate="True" Margin="0,0,10,0"
                                     Background="{StaticResource BorderBrush}" Foreground="{DynamicResource AccentBrush}"
                                     Visibility="{Binding IsSteamLoading, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding SteamStatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                    </StackPanel>
                </Grid>

                <!-- ══ Tab: Overview ════════════════════════════════════════ -->
                <views:GameDetailsOverviewTab />

                <!-- ══ Tab: Specs ═══════════════════════════════════════════ -->
                <views:GameDetailsSpecsTab />

                <!-- ══ Tab: Storage ═════════════════════════════════════════ -->
                <views:GameDetailsStorageTab />
            </StackPanel>
        </ScrollViewer>

        <!-- ══ Footer ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Notification / hint -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="  •  " FontSize="12" Foreground="#3D4656" />
                        <TextBlock Text="{Binding BuildTypeDisplay}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>

                    <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                            CornerRadius="5" Padding="12,6"
                            Visibility="{Binding HasNotificationMessage, Converter={StaticResource BoolToVis}}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="NotificationTransform" />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNotificationMessage}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.18" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                     From="8" To="0" Duration="0:0:0.18" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="#34D399" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NotificationMessage}" Margin="8,0,0,0" FontSize="12"
                                       Foreground="#A7F3D0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButtonStyle}" Height="42" MinWidth="150"
                            Command="{Binding CopySummaryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource GameDetailsCopyAll}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}" Height="42" MinWidth="104"
                            Margin="10,0,0,0" Command="{Binding CloseCommand}"
                            Content="{DynamicResource GameDetailsClose}" />

                    <Button Style="{StaticResource PrimaryCtaStyle}" MinWidth="210" Margin="14,0,0,0"
                            Command="{Binding PrimaryActionCommand}"
                            Content="{Binding PrimaryActionLabel}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

