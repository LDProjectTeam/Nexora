<Application x:Class="Vellum.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="Localization/Strings.ru.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BitmapImage x:Key="VellumAppIcon"
                         UriSource="pack://application:,,,/Vellum;component/Assets/VELLUM_icon_light.ico" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
