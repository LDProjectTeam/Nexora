<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The product and its test project must stay warning-free. Third-party tools
       in tools\ keep their own settings. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Nexora.Core' Or '$(MSBuildProjectName)' == 'Nexora.App' Or '$(MSBuildProjectName)' == 'Nexora.Tests'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
