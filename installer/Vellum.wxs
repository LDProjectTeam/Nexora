<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Vellum"
           Language="1033"
           Version="$(var.AppVersion)"
           Manufacturer="Vellum"
           UpgradeCode="C2A7F2D1-5B4E-4A1B-9E3C-8F6D7A2B1C90">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Platform="x64" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Vellum is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="VellumIcon" SourceFile="$(var.SourceRoot)\src\Vellum.App\Assets\VELLUM_icon_light.ico" />
    <Property Id="ARPPRODUCTICON" Value="VellumIcon" />
    <Property Id="ARPHELPLINK" Value="https://ldprojectteam.github.io/Vellum/" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="Vellum" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="VellumProgramsFolder" Name="Vellum" />
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="Vellum" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="VellumProgramsFolder" Guid="*">
      <Shortcut Id="VellumStartMenu"
                Name="Vellum"
                Description="Vellum game launcher"
                Target="[INSTALLFOLDER]Vellum.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="VellumIcon" />
      <RemoveFolder Id="RemoveVellumProgramsFolder" Directory="VellumProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\Vellum"
                     Name="StartMenuShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
